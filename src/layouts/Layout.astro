---
import "$/styles/global.css";
import Footer from "$/components/Footer.astro";
import Head from "$/components/head/Head.astro";
import Header from "$/components/header/Header.astro";
import type { SEOProps } from "$/env.d.ts";

type Props = SEOProps;

const { title, description } = Astro.props;
const { langCode } = Astro.locals;
---

<!doctype html>
<html lang={langCode}>
	<Head title={title} description={description} />
	<body class="min-w-80 mx-auto lg:max-w-240 lg:border lg:border-base-200">
		<Header />
		<slot />
		<Footer />
		<script src="$/scripts/theme-selector.ts"></script>
		<script src="$/scripts/language-selector.ts"></script>
	</body>
</html>
