---
import "$/styles/global.css";
import Footer from "$/components/Footer.astro";
import Head from "$/components/head/Head.astro";
import Header from "$/components/header/Header.astro";
import type { HeadProps } from "$/env";

type Props = HeadProps;

const { title, description } = Astro.props;
const langCode = Astro.locals.langCode;
---

<!doctype html>
<html lang={langCode}>
	<Head title={title} description={description} />
	<body
		class="mx-auto min-w-80 border-b border-line-on-light lg:max-w-250 lg:border-x dark:border-line-on-dark"
	>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<script src="$/scripts/theme-selector/theme-selector.js"></script>
	</body>
</html>
