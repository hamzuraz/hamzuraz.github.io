---
import "$/styles/global.css";
import Footer from "$/components/Footer.astro";
import Header from "$/components/header/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Rifki Muhazzar</title>
		<script is:inline>
			function getValueInLocalStorage() {
				const theme = localStorage.theme;
				if (theme !== "light" && theme !== "dark") {
					localStorage.removeItem("theme");
				}
				return theme === "dark" ||
					(!("theme" in localStorage) &&
						window.matchMedia("(prefers-color-scheme: dark)")
							.matches)
					? "dark"
					: "light";
			}
			document.documentElement.dataset.theme = getValueInLocalStorage();
		</script>
	</head>
	<body class="bg-primary-stone-200 dark:bg-primary-stone-950">
		<Header />
		<slot />
		<Footer />
		<script src="$/scripts/theme.ts"></script>
	</body>
</html>
