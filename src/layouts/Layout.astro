---
import "$/styles/global.css";
import Footer from "$/components/Footer.astro";
import Head from "$/components/head/Head.astro";
import Header from "$/components/header/Header.astro";
import type { HeadProps } from "$/env";

type Props = HeadProps;

const { title, description } = Astro.props;
const langCode = Astro.locals.langCode;
---

<!doctype html>
<html lang={langCode}>
	<Head title={title} description={description} />
	<body class="min-w-80 mx-auto lg:max-w-250 lg:border-2 lg:border-base-300">
		<Header />
		<slot />
		<Footer />
		<script src="$/scripts/theme-selector.ts"></script>
		<script src="$/scripts/common.ts"></script>
	</body>
</html>
