---
import "$/styles/global.css";
import Head from "$/components/head/Head.astro";

export interface Props {
	title: string;
	description: string;
	bodyClass?: string;
}

const { title, description, bodyClass = "" } = Astro.props;
const langCode = Astro.locals.langCode;
---

<!doctype html>
<html lang={langCode}>
	<Head title={title} description={description} />
	<body
		class:list={[
			"mx-auto min-w-80 lg:max-w-250 lg:border-x lg:border-neutral-400 lg:dark:border-neutral-700",
			bodyClass,
		]}
	>
		<slot />
		<script src="$/scripts/dropdown.ts"></script>
		<script src="$/scripts/theme.ts"></script>
	</body>
</html>
