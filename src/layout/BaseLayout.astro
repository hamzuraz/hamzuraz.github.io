---
import "@/styles/global.css";
import Toast from "@/components/common/toast/Toast.astro";
import Head from "@/components/head/Head.astro";
import { getLocale } from "@/i18n/i18n";

interface Props {
	title?: string;
	description?: string;
	pathWithoutLocale?: string;
	noindex?: boolean;
}

const { title, description, pathWithoutLocale, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang={getLocale(Astro.currentLocale)}>
	<Head
		title={title}
		description={description}
		pathWithoutLocale={pathWithoutLocale}
		noindex={noindex}
	/>
	<body
		class="min-w-75 max-w-250 mx-auto bg-border border-t divide-y lg:border-x"
	>
		<slot />
		<Toast />
		<script src="@/scripts/basecoat-css.ts"></script>
		<script src="@/scripts/contact-copy.ts"></script>
		<script src="@/scripts/footer-year.ts"></script>
		<script src="@/scripts/kbd-shortcuts.ts"></script>
		<script src="@/scripts/theme.ts"></script>
	</body>
</html>
