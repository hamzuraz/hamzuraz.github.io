---
import "@/styles/global.css";
import Head from "@/components/head/Head.astro";
import { getLocale } from "@/i18n/i18n";

interface Props {
	title?: string;
	description?: string;
	pathWithoutLocale?: string;
}

const { title, description, pathWithoutLocale } = Astro.props;
---

<!DOCTYPE html>
<html lang={getLocale(Astro.currentLocale)}>
	<Head
		title={title}
		description={description}
		pathWithoutLocale={pathWithoutLocale}
	/>
	<body class="p-px min-w-75 max-w-250 mx-auto bg-border">
		<slot />
		<script src="@/scripts/basecoat-css.ts"></script>
		<script src="@/scripts/contact-copy.ts"></script>
		<script src="@/scripts/kbd-shortcuts.ts"></script>
		<script src="@/scripts/theme.ts"></script>
	</body>
</html>
