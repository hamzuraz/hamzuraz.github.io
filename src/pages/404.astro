---
import { ChevronDown, Languages } from "@lucide/astro";
import "$/styles/global.css";
import Head from "$/components/head/Head.astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import { languages } from "$/i18n/i18n";
import { chevronIconProps, iconProps } from "$/utils/icon-props";

const langCode = Astro.locals.langCode;
---

<!doctype html>
<html lang={langCode}>
	<Head title="404 - Not Found" description="The page could not be found." />
	<body class="mx-auto min-w-80 lg:max-w-250 lg:border-x lg:r-border-subtle">
		<main class="flex min-h-screen items-center r-container-padding">
			<section class="w-full text-center">
				<p class="font-mono  r-text-subtle sm:text-sm">
					Error / Not Found
				</p>
				<h1
					class="mt-4 text-7xl font-bold tracking-tight text-base-content"
				>
					404
				</h1>
				<div
					class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
				>
					<a href="/" class="d-btn d-btn-primary w-60">
						Return to homepage (English)
					</a>
					<details
						name="dropdown"
						data-dropdown
						class="d-dropdown d-dropdown-center"
					>
						<summary
							class="d-btn d-btn-outline d-btn-primary justify-center gap-4 w-60"
						>
							<span class="flex items-center gap-2">
								<Languages {...iconProps} />
								Other languages
							</span>
							<ChevronDown
								{...chevronIconProps}
								class="dropdown-chevron transition-transform duration-200"
							/>
						</summary>
						<ul
							tabindex="-1"
							class="dropdown-menu d-menu d-dropdown-content z-1 mt-1 w-full rounded-box border r-border-subtle bg-base-100 shadow-sm"
						>
							{Object.entries(languages)
									.filter(([code]) => code !== langCode)
									.map(([code, language]) => (
										<li>
											<a
												href={buildLocalizedRoutePath(code, "/")}
												class="flex justify-between"
											>
												{language}
												<span
													class="font-mono text-xs r-text-subtle tracking-wider uppercase"
												>
													{code}
												</span>
											</a>
										</li>
									))}
						</ul>
					</details>
				</div>
			</section>
		</main>
		<script src="$/scripts/common.ts"></script>
		<script src="$/scripts/theme/theme.ts"></script>
	</body>
</html>

<style>
	.dropdown-menu {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-0.75rem);
		transition:
			transform 180ms ease,
			opacity 180ms ease,
			visibility 180ms ease;
	}

	details[open] > .dropdown-menu {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	details[open] > summary .dropdown-chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.dropdown-menu {
			transition: none;
		}
	}
</style>
