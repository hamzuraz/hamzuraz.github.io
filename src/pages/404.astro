---
import { Languages } from "@lucide/astro";
import Dropdown from "$/components/common/Dropdown.astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import { languages } from "$/i18n/i18n";
import BaseLayout from "$/layouts/BaseLayout.astro";
import { iconProps } from "$/utils/icon-props";

const langCode = Astro.locals.langCode;
---

<BaseLayout title="404 - Not Found" description="The page could not be found.">
	<main
		class="flex min-h-screen items-center px-4 py-12 sm:px-8 sm:pt-16 sm:pb-32"
	>
		<section class="w-full text-center">
			<p
				class="font-mono text-neutral-400 dark:text-neutral-500 sm:text-sm"
			>
				Error / Not Found
			</p>
			<h1
				class="mt-4 text-7xl font-bold tracking-tight text-base-content"
			>
				404
			</h1>
			<div
				class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
			>
				<a href="/" class="d-btn d-btn-primary w-60">
					Return to homepage (English)
				</a>
				<Dropdown
					placementClass="d-dropdown-center"
					summaryClass="d-btn-outline d-btn-primary justify-center gap-4 w-60"
					menuClass="mt-1 w-full"
				>
					<span slot="trigger" class="flex items-center gap-2">
						<Languages {...iconProps} />
						Other languages
					</span>

					{Object.entries(languages)
						.filter(([code]) => code !== langCode)
						.map(([code, language]) => (
							<li>
								<a
									href={buildLocalizedRoutePath(code, "/")}
									class="flex justify-between"
								>
									{language}
									<span class="font-mono text-xs text-neutral-400 dark:text-neutral-500 tracking-wider uppercase">
										{code}
									</span>
								</a>
							</li>
						))}
				</Dropdown>
			</div>
		</section>
	</main>
</BaseLayout>
