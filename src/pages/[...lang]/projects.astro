---
import Projects from "@/components/projects/Projects.astro";
import {
	getLocale,
	getLocaleStaticPaths,
	getPageTranslation,
	locales,
} from "@/i18n/i18n";
import { projectsPage } from "@/i18n/pages/projects/projectsPage";
import I18nLayout from "@/layout/I18nLayout.astro";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const locale = getLocale(Astro.currentLocale);
const t = getPageTranslation(projectsPage, locale);
const showFallback = t === undefined;
const languageName =
	locales.find(({ code }) => code === locale)?.name ?? locale;
---

<I18nLayout
	title={t?.head.title}
	description={t?.head.description}
	pathWithoutLocale={projectsPage.slug}
	showFallback={showFallback}
	languageName={languageName}
>
	<Projects locale={locale} t={t} />
</I18nLayout>
