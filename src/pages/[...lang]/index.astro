---
import SectionContact from "$/components/home/SectionContact.astro";
import SectionHero from "$/components/home/SectionHero.astro";
import SectionProjects from "$/components/home/SectionProjects.astro";
import SectionSkills from "$/components/home/SectionSkills.astro";
import Layout from "$/layouts/Layout.astro";

export { getLocalizedRouteStaticPaths as getStaticPaths } from "$/i18n/utils";

const t = Astro.locals.t;
---

<Layout title={t("home.title")} description={t("home.description")}>
	<SectionHero />
	<SectionProjects />
	<SectionSkills />
	<SectionContact />
</Layout>
