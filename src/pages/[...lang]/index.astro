---
import ContactSection from "$/components/home/ContactSection.astro";
import HeroSection from "$/components/home/HeroSection.astro";
import ProjectsSection from "$/components/home/ProjectsSection.astro";
import SkillsSection from "$/components/home/SkillsSection.astro";
import MainLayout from "$/layouts/MainLayout.astro";

export { getLocalizedRouteStaticPaths as getStaticPaths } from "$/i18n/helpers";

const t = Astro.locals.t;
---

<MainLayout title={t("home.title")} description={t("home.description")}>
	<HeroSection />
	<ProjectsSection />
	<SkillsSection />
	<ContactSection />
</MainLayout>
