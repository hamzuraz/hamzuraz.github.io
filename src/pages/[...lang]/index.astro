---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import DefaultButton from "@/components/common/DefaultButton.astro";
import ExternalLinks from "@/components/common/ExternalLinks.astro";
import OutlineButton from "@/components/common/OutlineButton.astro";
import ContactSection from "@/components/home/ContactSection.astro";
import SkillsSection from "@/components/home/SkillsSection.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getLocale, getLocaleStaticPaths, locales } from "@/i18n/i18n";
import NormalPageLayout from "@/layout/NormalPageLayout.astro";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const locale = getLocale(Astro.currentLocale);
const languageName =
	locales.find(({ code }) => code === locale)?.name ?? locale;

const featuredProjects = (
	await getCollection("projects", ({ data }) => data.featured)
)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const projectsUrl = getRelativeLocaleUrl(locale, "projects", {
	normalizeLocale: false,
});
---

<NormalPageLayout
	title="Rifki Muhazzar — Software Engineer"
	description="Personal portfolio of Rifki Muhazzar, a software engineer specializing in scalable web systems, modern user interfaces, and cloud architectures."
	path=""
>
	{locale === "en" ? (
	<>
		{/* 1. Hero Section */}
		<section class="py-12 sm:py-16 border-b border-border">
			<div class="flex items-center justify-between gap-4 mb-6">
				<span class="text-xs text-muted-foreground font-pixel tracking-wider uppercase">
					1 / SOFTWARE ENGINEER
				</span>
				<ExternalLinks />
			</div>

			<h1 class="font-pixel text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground">
				Rifki Muhazzar
			</h1>

			<p class="font-sans text-base sm:text-lg text-muted-foreground mt-4 max-w-2xl leading-relaxed">
				Full-stack software engineer building fast, reliable, and
				accessible applications across the modern web, mobile, and cloud
				environments.
			</p>

			<div class="flex flex-wrap items-center gap-3 mt-8">
				<DefaultButton href="#projects">See resume</DefaultButton>
				<OutlineButton href="#contact">Get in touch</OutlineButton>
			</div>
		</section>

		{/* 2. Selected Projects Section */}
		<section id="projects" class="py-12 border-b border-border">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
				<div>
					<span class="text-xs text-muted-foreground font-pixel tracking-wider uppercase">
						2 / SELECTED PROJECTS
					</span>
					<h2 class="font-pixel text-2xl sm:text-3xl font-bold mt-2">
						Selected Works
					</h2>
					<p class="font-sans text-sm sm:text-base text-muted-foreground mt-1 max-w-xl">
						A curated selection of production-grade architectures,
						open-source systems, and developer tooling.
					</p>
				</div>
				<a
					href={projectsUrl}
					class="inline-flex items-center gap-1 text-sm font-pixel font-semibold text-foreground hover:opacity-80 transition-opacity shrink-0"
				>
					See all projects &rarr;
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{featuredProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						description={project.data.description}
						techStack={project.data.techStack}
						coverImage={project.data.coverImage}
						sourceCodeUrl={project.data.sourceCodeUrl}
						sourceCodeButtonText={project.data.sourceCodeButtonText}
						liveDemoUrl={project.data.liveDemoUrl}
						liveDemoButtonText={project.data.liveDemoButtonText}
					/>
				))}
			</div>
		</section>

		{/* 3. Skills Section */}
		<SkillsSection />

		{/* 4. Contact Section */}
		<ContactSection />
	</>
) : (
	<section class="py-16 text-center">
		<p class="font-sans text-base text-muted-foreground">
			This page is not available in {languageName} yet, please choose
			another language.
		</p>
	</section>
)}
</NormalPageLayout>
