---
import {
	getLocale,
	getLocaleStaticPaths,
	getPageTranslation,
	locales,
	localizedPages,
} from "@/i18n/i18n";
import Layout from "@/layout/Layout.astro";

export function getStaticPaths() {
	return localizedPages.flatMap((page) =>
		getLocaleStaticPaths().map(({ params }) => ({
			params: { ...params, page: page.slug },
			props: { page },
		})),
	);
}

const { page } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const content = getPageTranslation(page, locale);

const languageName =
	locales.find(({ code }) => code === locale)?.name ?? locale;
---

<Layout path={page.slug}>
	{content ? (
	<section class="p-6">
		<h1>{content.title}</h1>
		<p>{content.description}</p>
	</section>
) : (
	<section class="p-6">
		<p>
			This page is not available in {languageName} yet, please choose
			another language
		</p>
	</section>
)}
</Layout>
