---
import {
	getLocale,
	getLocaleStaticPaths,
	getPageTranslation,
	locales,
	localizedPages,
} from "@/i18n/i18n";
import NormalPageLayout from "@/layout/NormalPageLayout.astro";

export function getStaticPaths() {
	return localizedPages.flatMap((page) =>
		getLocaleStaticPaths().map(({ params }) => ({
			params: { ...params, page: page.slug },
			props: { page },
		})),
	);
}

const { page } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const content = getPageTranslation(page, locale);

const languageName =
	locales.find(({ code }) => code === locale)?.name ?? locale;
---

<NormalPageLayout
	title={content ? `${content.title} | Rifki Muhazzar` : "Page | Rifki Muhazzar"}
	description={content?.description}
	path={page.slug}
>
	{content ? (
	<section class="py-12">
		<h1 class="font-pixel text-3xl font-bold tracking-tight text-foreground">
			{content.title}
		</h1>
		<p class="font-sans text-base text-muted-foreground mt-3 leading-relaxed">
			{content.description}
		</p>
	</section>
) : (
	<section class="py-16 text-center">
		<p class="font-sans text-base text-muted-foreground">
			This page is not available in {languageName} yet, please choose
			another language
		</p>
	</section>
)}
</NormalPageLayout>
