---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PanelLeftClose, PanelLeftOpen } from "@lucide/astro";
import LanguageSelector from "@/components/common/language/LanguageSelector.astro";
import ThemeSelector from "@/components/common/theme/ThemeSelector.astro";
import { localizeNav } from "@/i18n/common/localizeNav";
import { getLocale } from "@/i18n/i18n";
import { homePage } from "@/i18n/pages/home/homePage";
import { projectsPage } from "@/i18n/pages/projects/projectsPage";

interface Props {
	pathWithoutLocale?: string;
}

const { pathWithoutLocale } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const localizedNav = localizeNav(locale);

const homeUrl = getRelativeLocaleUrl(locale, homePage.slug, {
	normalizeLocale: false,
});
const projectsUrl = getRelativeLocaleUrl(locale, projectsPage.slug, {
	normalizeLocale: false,
});
---

<div class="lg:hidden">
	<button
		type="button"
		class="btn cursor-pointer"
		data-size="icon"
		aria-label={localizedNav.openMenu}
		onclick="document.getElementById('mobile-nav-drawer')?.showModal()"
	>
		<PanelLeftOpen class="w-5.5 h-5.5 stroke-[1.25]" />
	</button>
	<dialog id="mobile-nav-drawer" class="drawer" data-side="left">
		<article class="w-full max-w-max overflow-x-auto bg-border">
			<div class="w-max flex flex-col divide-y grow *:last:grow">
				<header
					class="relative p-3 sm:px-6 flex items-center bg-background rounded-b-lg"
				>
					<button
						type="button"
						class="btn cursor-pointer"
						data-size="icon"
						aria-label={localizedNav.closeMenu}
						onclick="this.closest('dialog')?.close()"
					>
						<PanelLeftClose class="w-5.5 h-5.5 stroke-[1.25]" />
					</button>
					<a
						href={homeUrl}
						class="absolute left-1/2 -translate-x-1/2 font-pixel text-xl tracking-widest hover:opacity-80 transition-opacity"
						aria-label="Rifki Muhazzar - Homepage"
					>
						RM
					</a>
				</header>
				<nav
					class="py-3 sm:px-3 flex flex-col text-sm text-muted-foreground bg-background rounded-lg"
				>
					<a
						href={projectsUrl}
						class="py-2 px-3 sm:rounded-md hover:bg-muted hover:text-foreground transition-colors"
						onclick="this.closest('dialog')?.close()"
					>
						{localizedNav.projects}
					</a>
					<a
						href={`${homeUrl}#skills`}
						class="py-2 px-3 sm:rounded-md hover:bg-muted hover:text-foreground transition-colors"
						onclick="this.closest('dialog')?.close()"
					>
						{localizedNav.skills}
					</a>
					<a
						href={`${homeUrl}#contact`}
						class="py-2 px-3 sm:rounded-md hover:bg-muted hover:text-foreground transition-colors"
						onclick="this.closest('dialog')?.close()"
					>
						{localizedNav.contact}
					</a>
				</nav>
				<div
					class="p-3 sm:px-6 flex flex-col gap-3 bg-background rounded-t-lg"
				>
					<ThemeSelector />
					<LanguageSelector pathWithoutLocale={pathWithoutLocale} />
				</div>
			</div>
		</article>
	</dialog>
</div>
