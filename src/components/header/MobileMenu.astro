---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Menu, X } from "@lucide/astro";
import { getLocale } from "@/i18n/i18n";

const locale = getLocale(Astro.currentLocale);
const homeUrl = getRelativeLocaleUrl(locale, "", { normalizeLocale: false });
const projectsUrl = getRelativeLocaleUrl(locale, "projects", {
	normalizeLocale: false,
});
---

<button
	type="button"
	class="btn sm:hidden cursor-pointer"
	data-size="icon"
	data-variant="outline"
	aria-label="Toggle navigation menu"
	onclick="document.getElementById('mobile-nav-drawer')?.showModal()"
>
	<Menu class="w-4 h-4" />
</button>

<dialog
	id="mobile-nav-drawer"
	class="drawer"
	data-side="top"
	aria-labelledby="mobile-nav-title"
>
	<article class="p-4 sm:p-6 flex flex-col gap-4">
		<header
			class="flex items-center justify-between pb-2 border-b border-border"
		>
			<span id="mobile-nav-title" class="font-pixel text-lg font-bold">
				Navigation
			</span>
			<button
				type="button"
				class="btn cursor-pointer"
				data-size="icon"
				data-variant="outline"
				aria-label="Close menu"
				onclick="this.closest('dialog')?.close()"
			>
				<X class="w-4 h-4" />
			</button>
		</header>
		<nav class="flex flex-col gap-2 font-sans text-base">
			<a
				href={projectsUrl}
				class="py-2 px-3 rounded-sm hover:bg-muted text-foreground transition-colors"
				onclick="this.closest('dialog')?.close()"
			>
				Projects
			</a>
			<a
				href={`${homeUrl}#skills`}
				class="py-2 px-3 rounded-sm hover:bg-muted text-foreground transition-colors"
				onclick="this.closest('dialog')?.close()"
			>
				Skills
			</a>
			<a
				href={`${homeUrl}#contact`}
				class="py-2 px-3 rounded-sm hover:bg-muted text-foreground transition-colors"
				onclick="this.closest('dialog')?.close()"
			>
				Contact
			</a>
		</nav>
	</article>
</dialog>
