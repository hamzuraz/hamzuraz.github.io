---
import { ChevronDown, SunMoon } from "@lucide/astro";
import { chevronIconProps, iconProps } from "$/utils/icon-props";

export interface Props {
	menuId: string;
}

const { menuId } = Astro.props;
const t = Astro.locals.t;
const anchorName = `--${menuId}-trigger`;
---

<button
	type="button"
	popovertarget={menuId}
	style={`anchor-name: ${anchorName}`}
	class="d-btn flex w-62 justify-between border-neutral-400 dark:border-neutral-700 lg:w-38"
>
	<span class="flex items-center gap-2">
		<SunMoon
			{...iconProps}
			class="shrink-0 text-neutral-400 dark:text-neutral-500"
		/>
		<span data-theme-active-text class="invisible">
			{"System"}
		</span>
	</span>
	<ChevronDown
		{...chevronIconProps}
		class="dropdown-chevron shrink-0 transition-transform duration-200 text-neutral-400 dark:text-neutral-500"
	/>
</button>

<ul
	id={menuId}
	popover="auto"
	style={`position-anchor: ${anchorName}`}
	class="popover-menu d-dropdown d-menu -mt-px w-62 rounded-box border border-neutral-400 bg-base-100 shadow-sm dark:border-neutral-700 lg:w-38"
>
	<li>
		<button type="button" data-theme-value="system">
			{t("header.theme.system")}
		</button>
	</li>
	<li>
		<button type="button" data-theme-value="light">
			{t("header.theme.light")}
		</button>
	</li>
	<li>
		<button type="button" data-theme-value="dark">
			{t("header.theme.dark")}
		</button>
	</li>
</ul>
