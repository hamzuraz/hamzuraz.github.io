---
import { ChevronDown, SunMoon } from "@lucide/astro";
import { chevronIconProps, iconProps } from "$/utils/icon-props";

const t = Astro.locals.t;
---

<details
	name="dropdown"
	data-dropdown
	class="d-dropdown d-dropdown-start w-full sm:w-auto"
>
	<summary
		class="d-btn flex w-62 lg:w-38 justify-between border-neutral-400 dark:border-neutral-700 group"
	>
		<div class="flex items-center gap-2">
			<SunMoon
				{...iconProps}
				class="shrink-0 text-neutral-400 dark:text-neutral-500"
			/>
			<span data-theme-active-text class="invisible">System</span>
		</div>
		<ChevronDown
			{...chevronIconProps}
			class="dropdown-chevron shrink-0 transition-transform duration-200 text-neutral-400 dark:text-neutral-500"
		/>
	</summary>

	<ul
		tabindex="-1"
		data-theme-menu
		class="dropdown-menu d-menu d-dropdown-content z-1 -mt-px w-full lg:w-38 rounded-box border border-neutral-400 dark:border-neutral-700 bg-base-100 shadow-sm"
	>
		<li>
			<span data-theme-value="system">{t("header.theme.system")}</span>
		</li>
		<li>
			<span data-theme-value="light">{t("header.theme.light")}</span>
		</li>
		<li>
			<span data-theme-value="dark">{t("header.theme.dark")}</span>
		</li>
	</ul>
</details>

<style>
	.dropdown-menu {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-0.75rem);
		transition:
			transform 180ms ease,
			opacity 180ms ease,
			visibility 180ms ease;
	}

	details[open] > .dropdown-menu {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	details[open] > summary .dropdown-chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.dropdown-menu {
			transition: none;
		}
	}
</style>
