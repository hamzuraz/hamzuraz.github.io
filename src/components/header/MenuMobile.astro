---
import { ExternalLink } from "@lucide/astro";
import { iconProps } from "$/lib/icon-props.ts";
import SelectorLanguage from "./SelectorLanguage.astro";
import SelectorTheme from "./SelectorTheme.astro";
---

<div class="d-collapse-content lg:hidden z-1">
    <ul class="d-menu border-b-2 border-base-300 w-full dark:border-base-100">
        <li><button>Projects</button></li>
        <li><button>Skills</button></li>
        <li><button>Contact</button></li>
        <li>
            <span
                class="pointer-events-none hover:bg-transparent hover:text-inherit"
            >
                Social
            </span>
            <ul>
                <li>
                    <button>
                        LinkedIn
                        <ExternalLink {...iconProps} />
                    </button>
                </li>
                <li>
                    <button>
                        GitHub
                        <ExternalLink {...iconProps} />
                    </button>
                </li>
            </ul>
        </li>
    </ul>

    <div class="d-menu">
        <SelectorTheme />
        <SelectorLanguage />
    </div>
</div>
