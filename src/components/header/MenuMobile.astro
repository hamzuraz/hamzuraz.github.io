---
import { navigationItems } from "$/data/navigation";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import LanguageSelector from "./LanguageSelector.astro";
import NavLink from "./NavLink.astro";
import ThemeSelector from "./ThemeSelector.astro";

const { langCode, t } = Astro.locals;
---

<nav
	id="mobile-navigation"
	popover="auto"
	class="mobile-nav-panel border-b border-neutral-400 bg-base-300 dark:border-neutral-700 sm:px-5 lg:hidden"
>
	<ul
		class="d-menu w-full border-b border-neutral-400 px-0 pt-4.5 pb-4 dark:border-neutral-700"
	>
		{navigationItems.map((item) => (
			<li>
				<NavLink
					href={buildLocalizedRoutePath(langCode, item.path)}
					label={t(item.labelKey)}
				/>
			</li>
		))}
	</ul>
	<div class="d-menu gap-3 px-4 py-6 sm:px-3">
		<ThemeSelector menuId="mobile-theme-selector-menu" />
		<LanguageSelector menuId="mobile-language-selector-menu" />
	</div>
</nav>

<style>
	.mobile-nav-panel {
		position: fixed;
		inset: unset;
		position-anchor: --mobile-navigation-toggle;
		top: anchor(bottom);
		left: 0;
		width: 100vw;
		margin: 0;

		transform: scaleY(0);
		transform-origin: top;
		opacity: 0;
		transition:
			transform 180ms ease,
			opacity 180ms ease,
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}

	.mobile-nav-panel:popover-open {
		transform: scaleY(1);
		opacity: 1;
	}

	@starting-style {
		.mobile-nav-panel:popover-open {
			transform: scaleY(0);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-panel {
			transition: none;
		}
	}
</style>
