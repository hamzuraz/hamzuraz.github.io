---
import { langCodeSegments } from "$/i18n/ui";
import LinkExternal from "./LinkExternal.astro";
import LinkInternal from "./LinkInternal.astro";
import SelectorLanguage from "./SelectorLanguage.astro";
import SelectorTheme from "./SelectorTheme.astro";

const langCode = Astro.locals.langCode;
const langCodeSegment = langCodeSegments[langCode];
const segment = langCodeSegment === "" ? "" : `/${langCodeSegment}`;
---

<div
    class="d-collapse-content z-1 border-line-on-light p-0 lg:hidden dark:border-line-on-dark"
>
    <ul
        class="d-menu w-full border-b border-line-on-light px-0 py-3 dark:border-line-on-dark"
    >
        <li><LinkInternal href={`${segment}/projects/`} label="Projects" /></li>
        <li><LinkInternal href={`${segment}/#skills`} label="Skills" /></li>
        <li><LinkInternal href={`${segment}/#contact`} label="contact" /></li>
        <li>
            <span
                class="pointer-events-none hover:bg-transparent hover:text-inherit"
            >
                Social
            </span>
            <ul
                class="border-l border-line-on-light pl-3 before:hidden dark:border-line-on-dark"
            >
                <li>
                    <LinkExternal
                        href="https://github.com/hamzuraz/"
                        label="GitHub"
                    />
                </li>
                <li>
                    <LinkExternal
                        href="https://linkedin.com/"
                        label="LinkedIn"
                    />
                </li>
            </ul>
        </li>
    </ul>
    <div class="d-menu gap-3 p-3 pb-6">
        <SelectorTheme />
        <SelectorLanguage />
    </div>
</div>
