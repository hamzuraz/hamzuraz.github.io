---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ChevronDown, Languages } from "@lucide/astro";
import { defaultLocale, getLocale, locales } from "@/i18n/i18n";
import LanguageCodeSpan from "./LanguageCodeSpan.astro";

interface Props {
	path?: string;
}

const { path } = Astro.props;
const currentLocale = getLocale(Astro.currentLocale ?? defaultLocale);
const currentLanguage = locales.find((locale) => locale.code === currentLocale);
---

<div id="language-selector" class="select">
	<button
		type="button"
		class="group w-50 cursor-pointer"
		id="language-selector-trigger"
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-controls="language-selector-listbox"
	>
		<Languages />
		<span class="truncate items-baseline">
			{currentLanguage?.label}
			<LanguageCodeSpan>
				{currentLanguage?.code}
			</LanguageCodeSpan>
		</span>
		<ChevronDown
			class="text-muted-foreground opacity-50 shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180"
		/>
	</button>
	<div id="language-selector-popover" data-popover aria-hidden="true">
		<div
			role="listbox"
			id="language-selector-listbox"
			aria-orientation="vertical"
			aria-labelledby="language-selector-trigger"
		>
			<div role="group" aria-labelledby="language-selector-languages">
				<span role="heading" id="language-selector-languages">
					Languages
				</span>
				{locales.map((language) => (
	<a
		href={getRelativeLocaleUrl(language.code, path)}
		aria-selected={language.code === currentLocale ? "true" : undefined}
		role="option"
		data-value={language.code}
		class="cursor-pointer items-baseline"
	>
		{language.label}
		<LanguageCodeSpan>{language.code}</LanguageCodeSpan>
	</a>
))}
			</div>
		</div>
	</div>
	<input type="hidden" name="language" value={currentLocale}>
</div>

<script src="@/scripts/language.ts"></script>
