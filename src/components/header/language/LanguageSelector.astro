---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Check, ChevronDown, Languages } from "@lucide/astro";
import Kbd from "@/components/common/Kbd.astro";
import { getLocale, locales } from "@/i18n/i18n";

interface Props {
	path?: string;
}

const { path } = Astro.props;
const currentLocale = getLocale(Astro.currentLocale);
const currentLanguage = locales.find((locale) => locale.code === currentLocale);
---

<div id="language-selector" class="dropdown-menu">
	<button
		type="button"
		id="language-selector-trigger"
		class="btn group w-58 cursor-pointer"
		data-shortcut="l"
		data-variant="outline"
		aria-controls="language-selector-menu"
		aria-expanded="false"
		aria-haspopup="menu"
	>
		<Languages />
		<span class="flex flex-1 truncate items-baseline gap-1.5">
			{currentLanguage?.name}
			<span class="text-xs text-muted-foreground">
				{currentLanguage?.code}
			</span>
		</span>
		<Kbd>L</Kbd>
		<ChevronDown
			class="text-muted-foreground opacity-50 shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180"
		/>
	</button>

	<div
		id="language-selector-popover"
		class="w-full"
		data-popover
		aria-hidden="true"
	>
		<div
			role="menu"
			id="language-selector-menu"
			aria-labelledby="language-selector-trigger"
		>
			<div role="group" aria-labelledby="language-selector-languages">
				<div role="heading" id="language-selector-languages">
					Languages
				</div>
				{locales.map((language) => (
	<a
		href={getRelativeLocaleUrl(language.code, path, {
			normalizeLocale: false,
		})}
		role="menuitemradio"
		class="cursor-pointer items-baseline"
		aria-checked={language.code === currentLocale ? "true" : "false"}
	>
		{language.name}
		<span class="text-xs text-muted-foreground pointer-events-none">
			{language?.code}
		</span>
		<span data-indicator>
			<Check />
		</span>
	</a>
))}
			</div>
		</div>
	</div>
</div>
