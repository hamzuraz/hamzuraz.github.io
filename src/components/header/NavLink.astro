---
export interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
const linkUrl = new URL(href, Astro.url);
const isCurrent = !linkUrl.hash && linkUrl.pathname === Astro.url.pathname;
---

<a
	href={href}
	class:list={[
		"px-4 sm:px-3 rounded-none sm:rounded-box transition-colors hover:bg-base-content/10 hover:text-base-content",
		{
			"bg-base-content/10 text-base-content font-medium": isCurrent,
		},
	]}
	aria-current={isCurrent ? "page" : undefined}
>
	{label}
</a>
