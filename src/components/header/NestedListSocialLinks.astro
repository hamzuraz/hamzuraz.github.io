---
import { ExternalLink } from "@lucide/astro";
import { iconProps } from "$/lib/icon-props";

type Props = {
	href: string;
	label: string;
};

const { href, label } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer">
    {label}
    <ExternalLink {...iconProps} />
</a>
