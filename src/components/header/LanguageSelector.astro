---
import { ChevronDown, Languages } from "@lucide/astro";
import { languages } from "$/i18n/ui.ts";
import { buildLocalizedPath } from "$/i18n/utils.ts";

const langCode = Astro.locals.langCode;
const pathname = Astro.url.pathname;
---

<div class="d-dropdown d-dropdown-start">
    <div tabindex="0" role="button" class="d-btn m-1 w-62 flex justify-between">
        <div class="font-normal flex gap-3">
            <Languages size={16} stroke-width={1.25} class="translate-y-0.5" />
            <div class="flex items-baseline gap-1">
                <span>{languages[langCode]}</span>
                <span class="text-xs font-mono opacity-60 uppercase">
                    {langCode}
                </span>
            </div>
        </div>
        <ChevronDown size={16} stroke-width={1.5} />
    </div>

    <ul
        id="language-selector"
        tabindex="-1"
        class="d-dropdown-content d-menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
    >
        {
            Object.entries(languages).map(([code, name]) => {
                const path = buildLocalizedPath(code, pathname);
                return (
                    <li>
                        <a
                            href={path}
                            data-lang-code={code}
                            class="flex justify-between"
                        >
                            {name}
                            <span class="text-xs font-mono opacity-60 uppercase">
                                {code}
                            </span>
                        </a>
                    </li>
                );
            })
        }
    </ul>
</div>
