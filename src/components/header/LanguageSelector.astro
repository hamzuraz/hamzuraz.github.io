---
import { languages } from "$/i18n/ui.ts";
---

<select
    id="language-selector"
    class="d-select [&::picker(select)]:max-h-52 cursor-pointer hover:bg-base-200"
>
    {
        Object.entries(languages).map(([key, value]) => (
            <option value={key}>{value}</option>
        ))
    }
</select>
