---
import { ChevronDown } from "@lucide/astro";
import { langCodeSegments } from "$/i18n/ui";
import { chevronProps } from "$/lib/icon-props";
import LinkExternal from "./LinkExternal.astro";
import LinkInternal from "./LinkInternal.astro";
import SelectorLanguage from "./SelectorLanguage.astro";
import SelectorTheme from "./SelectorTheme.astro";

const { langCode, t } = Astro.locals;

const langCodeSegment = langCodeSegments[langCode];
const segment = langCodeSegment === "" ? "" : `/${langCodeSegment}`;
---

<div class="d-navbar-center hidden lg:flex">
    <ul class="d-menu d-menu-horizontal p-0">
        <li>
            <LinkInternal
                href={`${segment}/projects/`}
                label={t("header.nav.projects")}
            />
        </li>
        <li>
            <LinkInternal
                href={`${segment}/#skills`}
                label={t("header.nav.skills")}
            />
        </li>
        <li>
            <LinkInternal
                href={`${segment}/#contact`}
                label={t("header.nav.contact")}
            />
        </li>
        <li>
            <LinkExternal href="https://github.com/hamzuraz" label="GitHub" />
        </li>
    </ul>
    <div class="ml-3 flex gap-3">
        <SelectorTheme />
        <SelectorLanguage />
    </div>
</div>
