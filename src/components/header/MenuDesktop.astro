---
import { ChevronDown } from "@lucide/astro";
import { langCodeSegments } from "$/i18n/ui";
import { chevronProps } from "$/lib/icon-props";
import LinkExternal from "./LinkExternal.astro";
import LinkInternal from "./LinkInternal.astro";
import SelectorLanguage from "./SelectorLanguage.astro";
import SelectorTheme from "./SelectorTheme.astro";

const { langCode, t } = Astro.locals;

const langCodeSegment = langCodeSegments[langCode];
const segment = langCodeSegment === "" ? "" : `/${langCodeSegment}`;
---

<div class="d-navbar-center hidden lg:flex">
    <ul class="d-menu d-menu-horizontal p-0">
        <li>
            <LinkInternal
                href={`${segment}/projects/`}
                label={t("header.nav.projects")}
            />
        </li>
        <li>
            <LinkInternal
                href={`${segment}/#skills`}
                label={t("header.nav.skills")}
            />
        </li>
        <li>
            <LinkInternal
                href={`${segment}/#contact`}
                label={t("header.nav.contact")}
            />
        </li>
        <li>
            <div class="[all:unset] d-dropdown d-dropdown-center">
                <div
                    tabindex="0"
                    role="button"
                    class="d-btn d-btn-ghost hover:bg-base-100 font-normal group px-3"
                >
                    Social
                    <ChevronDown
                        {...chevronProps}
                        class="transition-transform duration-200 group-focus:rotate-180"
                    />
                </div>
                <ul
                    tabindex="-1"
                    class="d-dropdown-content d-menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm border u-border-color -mt-px max-w-38"
                >
                    <li>
                        <LinkExternal href="github.com" label="GitHub" />
                    </li>
                    <li>
                        <LinkExternal href="linkedin.com" label="LinkedIn" />
                    </li>
                </ul>
            </div>
        </li>
    </ul>
    <div class="flex gap-3 ml-3">
        <SelectorTheme />
        <SelectorLanguage />
    </div>
</div>
