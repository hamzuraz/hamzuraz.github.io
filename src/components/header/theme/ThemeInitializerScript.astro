---
interface Props {
	themeIds: string[];
}

const { themeIds } = Astro.props;
---

<script is:inline define:vars={{ themeIds }}>
	const storageKey = "theme";
	const validThemes = new Set(themeIds);
	const fallbackTheme = window.matchMedia("(prefers-color-scheme: dark)")
		.matches
		? "default-dark"
		: "default-light";

	document.documentElement.dataset.theme = fallbackTheme;

	try {
		const savedTheme = window.localStorage.getItem(storageKey);
		if (savedTheme && validThemes.has(savedTheme)) {
			document.documentElement.dataset.theme = savedTheme;
		}
	} catch {
		// Storage may be unavailable (private mode, quota, blocked).
	}
</script>
