---
import { Check, ChevronDown, Wallpaper } from "@lucide/astro";
import Kbd from "@/components/common/Kbd.astro";
import ThemeInitializerScript from "./ThemeInitializerScript.astro";
import ThemeSelectorScript from "./ThemeSelectorScript.astro";

const themes = [
	{ id: "default-light", name: "Default", mode: "Light" },
	{ id: "default-dark", name: "Default", mode: "Dark" },
	{ id: "brutalist-light", name: "Brutalist", mode: "Light" },
	{ id: "brutalist-dark", name: "Brutalist", mode: "Dark" },
	{ id: "monochrome-light", name: "Monochrome", mode: "Light" },
	{ id: "monochrome-dark", name: "Monochrome", mode: "Dark" },
	{ id: "sandstone-light", name: "Sandstone", mode: "Light" },
	{ id: "sandstone-dark", name: "Sandstone", mode: "Dark" },
	{ id: "terracotta-light", name: "Terracotta", mode: "Light" },
	{ id: "terracotta-dark", name: "Terracotta", mode: "Dark" },
];
---

<ThemeInitializerScript themeIds={themes.map((theme) => theme.id)} />

<div id="theme-selector" class="dropdown-menu">
	<button
		type="button"
		id="theme-selector-trigger"
		class="btn group w-60 cursor-pointer"
		data-shortcut="t"
		data-variant="outline"
		aria-controls="theme-selector-menu"
		aria-expanded="false"
		aria-haspopup="menu"
	>
		<Wallpaper />
		<span class="truncate w-full text-left">
			<span class="text-sm text-foreground" data-theme-name></span>{" "}
			<span class="text-xs text-muted-foreground" data-theme-mode></span>
		</span>
		<Kbd>T</Kbd>
		<ChevronDown
			class="text-muted-foreground opacity-50 shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180"
		/>
	</button>

	<div
		id="theme-selector-popover"
		class="w-full"
		data-popover
		aria-hidden="true"
	>
		<div
			role="menu"
			id="theme-selector-menu"
			aria-labelledby="theme-selector-trigger"
		>
			<div role="group" aria-labelledby="theme-selector-themes">
				<div role="heading" id="theme-selector-themes">Themes</div>
				{themes.map((theme) => (
	<div
		role="menuitemradio"
		class="cursor-pointer"
		data-value={theme.id}
		data-theme-name={theme.name}
		data-theme-mode={theme.mode}
		aria-checked={theme.id === "default-light" ? "true" : "false"}
	>
		<span>{theme.name}</span>
		<span class="text-xs text-muted-foreground">{theme.mode}</span>
		<span data-indicator>
			<Check />
		</span>
	</div>
))}
				<hr role="separator">
				<div
					role="menuitemradio"
					class="cursor-pointer"
					data-value="reset"
					data-variant="destructive"
				>
					<span>Reset theme preferences</span>
					<span data-indicator>
						<Check />
					</span>
				</div>
			</div>
		</div>
	</div>
</div>

<ThemeSelectorScript />
