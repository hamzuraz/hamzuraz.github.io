---
import { Logs } from "@lucide/astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import MenuDesktop from "./MenuDesktop.astro";
import MenuMobile from "./MenuMobile.astro";

const langCode = Astro.locals.langCode;
const localizedHomePath = buildLocalizedRoutePath(langCode, "/");
---

<header
	class="sticky top-0 z-100 rounded-none"
	data-mobile-navigation-open="false"
>
	<button
		type="button"
		data-mobile-navigation-backdrop
		class="mobile-nav-backdrop fixed inset-0 z-10 border-0 bg-black/25 p-0 opacity-0 lg:hidden"
		aria-label="Close navigation"
	></button>
	<div
		class="d-navbar relative z-30 border-y border-neutral-400 dark:border-neutral-700 bg-base-300 px-4 sm:px-8"
	>
		<div class="d-navbar-start">
			<button
				type="button"
				data-mobile-navigation-toggle
				class="d-btn border-neutral-400 dark:border-neutral-700 px-4 lg:hidden"
				aria-label="Toggle navigation"
				aria-controls="mobile-navigation"
				aria-expanded="false"
			>
				<Logs />
			</button>
			<a
				href={localizedHomePath}
				class="d-btn border-neutral-400 dark:border-neutral-700 px-3 text-xl tracking-wide max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2"
			>
				RM
			</a>
		</div>
		<MenuDesktop />
	</div>
	<MenuMobile />
</header>

<style>
	.mobile-nav-backdrop {
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 180ms ease,
			visibility 0s linear 180ms;
	}

	:global(header[data-mobile-navigation-open="true"] .mobile-nav-backdrop) {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transition:
			opacity 180ms ease,
			visibility 0s;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-backdrop {
			transition: none;
		}
	}
</style>
