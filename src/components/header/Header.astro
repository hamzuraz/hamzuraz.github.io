---
import { Logs } from "@lucide/astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import MenuDesktop from "./MenuDesktop.astro";
import MenuMobile from "./MenuMobile.astro";

const langCode = Astro.locals.langCode;
const localizedHomePath = buildLocalizedRoutePath(langCode, "/");
---

<header class="sticky top-0 z-100">
	<div
		class="d-navbar relative border-y border-neutral-400 bg-base-300 px-4 dark:border-neutral-700 sm:px-8"
	>
		<div class="d-navbar-start">
			<button
				type="button"
				popovertarget="mobile-navigation"
				style="anchor-name: --mobile-navigation-toggle"
				class="d-btn border-neutral-400 px-4 dark:border-neutral-700 lg:hidden"
				aria-label="Toggle navigation"
			>
				<Logs />
			</button>
			<a
				href={localizedHomePath}
				class="d-btn border-neutral-400 px-3 text-xl tracking-wide dark:border-neutral-700 max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2"
			>
				RM
			</a>
		</div>
		<MenuDesktop />
	</div>
	<MenuMobile />
</header>
