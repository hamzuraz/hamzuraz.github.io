---
import MenuDesktop from "./MenuDesktop.astro";
import MenuMobile from "./MenuMobile.astro";

const langCode = Astro.locals.langCode;
const localizedHomePath = langCode === "en-US" ? "/" : `/${langCode}/`;
---

<header
    class="rounded-none border-b border-line-on-light bg-base-300 px-4 max-lg:d-collapse sm:px-8 dark:border-line-on-dark"
>
    <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
    <label
        for="navbar-1-toggle"
        class="fixed inset-0 hidden max-lg:peer-checked:block"
    >
    </label>
    <div class="d-collapse-title d-navbar p-0">
        <div class="d-navbar-start">
            <label
                for="navbar-1-toggle"
                class="d-btn border-line-on-light lg:hidden dark:border-line-on-dark"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h8m-8 6h16"
                    >
                    </path>
                </svg>
            </label>
            <a
                href={localizedHomePath}
                class="d-btn border-line-on-light px-3 text-xl max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2 dark:border-line-on-dark"
            >
                RM
            </a>
        </div>
        <MenuDesktop />
    </div>
    <MenuMobile />
</header>

<script src="$/scripts/header.ts"></script>
