---
import { Logs } from "@lucide/astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import MenuDesktop from "./MenuDesktop.astro";
import MenuMobile from "./MenuMobile.astro";

const langCode = Astro.locals.langCode;
const localizedHomePath = buildLocalizedRoutePath(langCode, "/");
---

<header
	class="sticky top-0 z-100 rounded-none border-y border-neutral-400 dark:border-neutral-700 bg-base-300 px-4 sm:px-8"
>
	<input
		id="mobile-nav-toggle"
		class="peer sr-only"
		type="checkbox"
		aria-label="Toggle navigation"
	>
	<label
		for="mobile-nav-toggle"
		class="mobile-nav-backdrop fixed inset-0 z-20 bg-black/25 opacity-0 max-lg:pointer-events-none lg:hidden"
		aria-label="Close navigation"
	> </label>
	<div class="d-navbar relative z-30 p-0">
		<div class="d-navbar-start">
			<label
				for="mobile-nav-toggle"
				class="d-btn border-neutral-400 dark:border-neutral-700 px-4 lg:hidden"
				aria-label="Toggle navigation"
			>
				<Logs />
			</label>
			<a
				href={localizedHomePath}
				class="d-btn border-neutral-400 dark:border-neutral-700 px-3 text-xl tracking-wide max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2"
			>
				RM
			</a>
		</div>
		<MenuDesktop />
	</div>
	<MenuMobile />
</header>

<style>
	.mobile-nav-backdrop {
		transition: opacity 180ms ease;
	}

	:global(#mobile-nav-toggle:checked ~ .mobile-nav-backdrop) {
		opacity: 1;
		pointer-events: auto;
	}

	:global(#mobile-nav-toggle:checked ~ .d-navbar ~ #mobile-navigation) {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-backdrop {
			transition: none;
		}
	}
</style>
