---
import MenuDesktop from "./menu/MenuDesktop.astro";
import MenuMobile from "./menu/MenuMobile.astro";

const langCode = Astro.locals.langCode;
const localizedHomePath = langCode === "en-US" ? "/" : `/${langCode}/`;
---

<header
    class="sticky top-0 z-100 rounded-none border-y u-border-color bg-base-300 px-4 sm:px-8"
>
    <input
        id="mobile-nav-toggle"
        class="peer sr-only"
        type="checkbox"
        aria-label="Toggle navigation"
    />
    <label
        for="mobile-nav-toggle"
        class="mobile-nav-backdrop fixed inset-0 z-10 bg-black/30 opacity-0 max-lg:pointer-events-none lg:hidden"
        aria-label="Close navigation"
    >
    </label>
    <div class="d-navbar relative z-20 p-0">
        <div class="d-navbar-start">
            <label
                for="mobile-nav-toggle"
                class="d-btn u-border-color lg:hidden"
                aria-label="Toggle navigation"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"
                    >
                    </path>
                </svg>
            </label>
            <a
                href={localizedHomePath}
                class="d-btn u-border-color px-3 text-xl max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2"
            >
                RM
            </a>
        </div>
        <MenuDesktop />
    </div>
    <MenuMobile />
</header>

<style>
    .mobile-nav-backdrop {
        transition: opacity 180ms ease;
    }

    :global(#mobile-nav-toggle:checked ~ .mobile-nav-backdrop) {
        opacity: 1;
        pointer-events: auto;
    }

    :global(#mobile-nav-toggle:checked ~ .d-navbar ~ #mobile-navigation) {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .mobile-nav-backdrop {
            transition: none;
        }
    }
</style>
