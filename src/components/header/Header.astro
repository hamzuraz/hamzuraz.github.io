---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale } from "@/i18n/i18n";
import { homePage } from "@/i18n/pages/home/homePage";
import DesktopMenu from "./DesktopMenu.astro";
import MobileMenu from "./MobileMenu.astro";

interface Props {
	pathWithoutLocale?: string;
}

const { pathWithoutLocale } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const homeUrl = getRelativeLocaleUrl(locale, homePage.slug, {
	normalizeLocale: false,
});
---

<header class="p-3 sm:px-6 bg-background rounded-b-lg">
	<div class="flex items-center justify-between gap-4">
		<MobileMenu pathWithoutLocale={pathWithoutLocale} />
		<a
			href={homeUrl}
			class="font-pixel text-xl tracking-widest hover:opacity-80 transition-opacity"
			aria-label="Rifki Muhazzar - Homepage"
		>
			RM
		</a>
		<DesktopMenu pathWithoutLocale={pathWithoutLocale} />
		<div class="lg:hidden w-9" aria-hidden="true"></div>
	</div>
</header>
