---
import { ChevronDown, Paintbrush } from "@lucide/astro";
import { chevronProps, defaultIconProps } from "$/lib/icon-props";

const t = Astro.locals.t;
---

<div class="d-dropdown d-dropdown-start">
    <div
        tabindex="0"
        role="button"
        class="d-btn flex w-38 justify-between u-border-color"
    >
        <div class="flex gap-2">
            <Paintbrush {...defaultIconProps} class="translate-y-0.5" />
            <span data-theme-active-text class="invisible">System</span>
        </div>
        <ChevronDown {...chevronProps} />
    </div>
    <ul
        data-theme-menu
        tabindex="-1"
        class="d-menu d-dropdown-content z-1 w-38 rounded-box bg-base-100 shadow-sm border u-border-color -mt-px"
    >
        <li>
            <a href="" data-theme-value="system">{t("header.theme.system")}</a>
        </li>
        <li>
            <a href="" data-theme-value="light">{t("header.theme.light")}</a>
        </li>
        <li>
            <a href="" data-theme-value="dark">{t("header.theme.dark")}</a>
        </li>
    </ul>
</div>
