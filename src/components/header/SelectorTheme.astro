---
import { ChevronDown, Paintbrush } from "@lucide/astro";
---

<div class="d-dropdown d-dropdown-start">
    <div
        tabindex="0"
        role="button"
        class="d-btn m-1 w-38 flex justify-between dark:border-base-content/60"
    >
        <div class="flex gap-3">
            <Paintbrush size={16} stroke-width={1.25} class="translate-y-0.5" />
            <span data-theme-active class="first-letter:uppercase font-normal">
                System
            </span>
        </div>
        <ChevronDown size={16} stroke-width={1.5} />
    </div>

    <ul
        data-theme-selector
        tabindex="-1"
        class="d-dropdown-content d-menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
    >
        <li><a href="" data-theme-value="system">System</a></li>
        <li><a href="" data-theme-value="light">Light</a></li>
        <li><a href="" data-theme-value="dark">Dark</a></li>
    </ul>
</div>
