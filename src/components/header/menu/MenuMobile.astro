---
import { langCodeSegments } from "$/i18n/ui";
import LinkExternal from "./link/LinkExternal.astro";
import LinkInternal from "./link/LinkInternal.astro";
import SelectorLanguage from "./selector/SelectorLanguage.astro";
import SelectorTheme from "./selector/SelectorTheme.astro";

const langCode = Astro.locals.langCode;
const langCodeSegment = langCodeSegments[langCode];
const segment = langCodeSegment === "" ? "" : `/${langCodeSegment}`;
---

<div class="d-collapse-content z-1 u-border-color p-0 lg:hidden">
    <ul class="d-menu w-full border-b u-border-color px-0 py-3">
        <li><LinkInternal href={`${segment}/projects/`} label="Projects" /></li>
        <li><LinkInternal href={`${segment}/#skills`} label="Skills" /></li>
        <li><LinkInternal href={`${segment}/#contact`} label="contact" /></li>
        <li>
            <LinkExternal href="https://github.com/hamzuraz/" label="GitHub" />
        </li>
    </ul>
    <div class="d-menu gap-3 p-3 pb-6">
        <SelectorTheme />
        <SelectorLanguage />
    </div>
</div>
