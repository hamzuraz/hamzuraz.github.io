---
import { ExternalLink } from "@lucide/astro";
import type { LinkProps } from "$/env";
import { defaultIconProps } from "$/lib/icon-props";

type Props = LinkProps;

const { href, label } = Astro.props;
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="flex max-w-40 items-center justify-between"
>
    {label}
    <ExternalLink {...defaultIconProps} class="relative -top-px" />
</a>
