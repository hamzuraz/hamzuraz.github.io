---
import { ChevronDown, Palette } from "@lucide/astro";

import { chevronIconProps, iconProps } from "$/utils/icon-props";

const t = Astro.locals.t;
---

<details name="dropdown" data-dropdown class="d-dropdown d-dropdown-start">
	<summary class="d-btn flex lg:w-38 justify-between r-border-subtle group">
		<div class="flex gap-2">
			<Palette {...iconProps} class="translate-y-0.75" />
			<span data-theme-active-text class="invisible">System</span>
		</div>
		<ChevronDown
			{...chevronIconProps}
			class="dropdown-chevron transition-transform duration-200"
		/>
	</summary>
	<ul
		data-theme-menu
		tabindex="-1"
		class="dropdown-menu d-menu d-dropdown-content z-1 w-full lg:w-38 rounded-box bg-base-100 shadow-sm border r-border-subtle -mt-px"
	>
		<li>
			<span data-theme-value="system">{t("header.theme.system")}</span>
		</li>
		<li>
			<span data-theme-value="light">{t("header.theme.light")}</span>
		</li>
		<li>
			<span data-theme-value="dark">{t("header.theme.dark")}</span>
		</li>
	</ul>
</details>

<style>
	.dropdown-menu {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-0.75rem);
		transition:
			transform 180ms ease,
			opacity 180ms ease,
			visibility 180ms ease;
	}

	details[open] > .dropdown-menu {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	details[open] > summary .dropdown-chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.dropdown-menu {
			transition: none;
		}
	}
</style>
