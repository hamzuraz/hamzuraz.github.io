---
import type { LinkProps } from "$/env";

type Props = LinkProps;

const { href, label } = Astro.props;
const linkUrl = new URL(href, Astro.url);
const isCurrent = !linkUrl.hash && linkUrl.pathname === Astro.url.pathname;
---

<a
	href={href}
	class:list={[
        "px-4 sm:px-3 rounded-none sm:rounded-box",
        {
            "r-current font-medium": isCurrent,
        },
    ]}
	aria-current={isCurrent ? "page" : undefined}
>
	{label}
</a>
