---
import { ChevronDown, Languages } from "@lucide/astro";
import { languages } from "$/i18n/ui";
import { buildLocalizedRoutePath } from "$/i18n/utils";
import { chevronProps, iconProps } from "$/lib/icon-props";

const langCode = Astro.locals.langCode;
const pathname = Astro.url.pathname;
---

<div class="d-dropdown d-dropdown-start">
    <div
        tabindex="0"
        role="button"
        class="d-btn m-1 w-62 flex justify-between dark:border-base-content/50"
    >
        <div class="font-normal flex gap-3">
            <Languages {...iconProps} class="translate-y-0.5" />

            <div class="flex items-baseline gap-1">
                <span>{languages[langCode]}</span>
                <span class="text-xs font-mono opacity-60 uppercase">
                    {langCode}
                </span>
            </div>
        </div>

        <ChevronDown {...chevronProps} />
    </div>

    <ul
        tabindex="-1"
        class="d-dropdown-content d-menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
    >
        {
            Object.entries(languages).map(([langCode, langName]) => {
                return (
                    <li>
                        <a
                            href={buildLocalizedRoutePath(langCode, pathname)}
                            class="flex justify-between"
                        >
                            {langName}
                            <span class="text-xs font-mono opacity-60 uppercase">
                                {langCode}
                            </span>
                        </a>
                    </li>
                );
            })
        }
    </ul>
</div>
