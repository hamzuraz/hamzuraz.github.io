---
import { ChevronDown, Languages } from "@lucide/astro";
import { languages } from "$/i18n/ui";
import { buildLocalizedRoutePath } from "$/i18n/utils";
import { chevronProps, defaultIconProps } from "$/lib/icon-props";

const langCode = Astro.locals.langCode;
const pathname = Astro.url.pathname;
---

<div class="d-dropdown d-dropdown-start">
    <div
        tabindex="0"
        role="button"
        class="d-btn flex w-62 justify-between border-line-on-light dark:border-line-on-dark"
    >
        <div class="flex gap-2">
            <Languages {...defaultIconProps} class="translate-y-0.5" />
            <div class="flex items-baseline gap-2">
                <span>{languages[langCode]}</span>
                <span
                    class="font-mono text-xs text-subtle-on-light uppercase dark:text-subtle-on-dark"
                >
                    {langCode}
                </span>
            </div>
        </div>
        <ChevronDown {...chevronProps} />
    </div>
    <ul
        tabindex="-1"
        class="d-menu d-dropdown-content z-1 w-62 rounded-box bg-base-100 shadow-sm"
    >
        {
            Object.entries(languages).map(([langCode, langName]) => {
                return (
                    <li>
                        <a
                            href={buildLocalizedRoutePath(langCode, pathname)}
                            class="flex justify-between"
                        >
                            {langName}
                            <span class="font-mono text-xs text-subtle-on-light uppercase dark:text-subtle-on-dark">
                                {langCode}
                            </span>
                        </a>
                    </li>
                );
            })
        }
    </ul>
</div>
