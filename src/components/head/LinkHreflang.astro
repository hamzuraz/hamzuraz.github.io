---
import { defaultLangCode, languages } from "$/i18n/ui";
import { buildLocalizedPath, getObjectKeys } from "$/i18n/utils";

const pathname = Astro.url.pathname;
const siteUrl = Astro.site;

const langCodes = getObjectKeys(languages);
---

{
    langCodes.map((lang) => (
        <link
            rel="alternate"
            hreflang={lang}
            href={new URL(buildLocalizedPath(lang, pathname), siteUrl)}
        />
    ))
}
<link
    rel="alternate"
    hreflang="x-default"
    href={new URL(buildLocalizedPath(defaultLangCode, pathname), siteUrl)}
/>
