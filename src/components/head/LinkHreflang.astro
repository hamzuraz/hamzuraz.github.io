---
import { getObjectKeys } from "$/i18n/type-helpers";
import { langCodeDefault, languages } from "$/i18n/ui";
import { buildLocalizedRoutePath } from "$/i18n/utils";

const pathname = Astro.url.pathname;
const siteUrl = Astro.site;

const langCodes = getObjectKeys(languages);
---

{
    langCodes.map((langCode) => (
        <link
            rel="alternate"
            hreflang={langCode}
            href={new URL(buildLocalizedRoutePath(langCode, pathname), siteUrl)}
        />
    ))
}
<link
    rel="alternate"
    hreflang="x-default"
    href={new URL(buildLocalizedRoutePath(langCodeDefault, pathname), siteUrl)}
/>
