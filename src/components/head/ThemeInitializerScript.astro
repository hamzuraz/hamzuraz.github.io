---
import { themes } from "@/data/themes";

const themeIds = themes.map<string>((theme) => theme.id);
---

<script define:vars={{ themeIds }}>
	const storageKey = "theme";
	const root = document.documentElement;
	const fallbackTheme = matchMedia("(prefers-color-scheme: dark)").matches
		? "default-dark"
		: "default-light";

	root.dataset.theme = fallbackTheme;

	try {
		const savedTheme = localStorage.getItem(storageKey);
		if (savedTheme && themeIds.includes(savedTheme)) {
			root.dataset.theme = savedTheme;
		}
	} catch {
		// Storage may be unavailable (private mode, quota, blocked).
	}
</script>
