---
import { langCodeDefault, langCodes } from "$/i18n/config";
import { buildLocalizedRoutePath } from "$/i18n/helpers";

const pathname = Astro.url.pathname;
const siteUrl = Astro.site;
---

{langCodes.map((langCode) => (
	<link
		rel="alternate"
		hreflang={langCode}
		href={new URL(buildLocalizedRoutePath(langCode, pathname), siteUrl)}
	/>
))}
<link
	rel="alternate"
	hreflang="x-default"
	href={new URL(buildLocalizedRoutePath(langCodeDefault, pathname), siteUrl)}
>
