---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { defaultLocale, locales } from "@/i18n/i18n";

interface Props {
	pathWithoutLocale?: string;
}

const { pathWithoutLocale } = Astro.props;
---

{locales.map((locale) => (
	<link
		rel="alternate"
		hreflang={locale.code}
		href={getAbsoluteLocaleUrl(locale.code, pathWithoutLocale, {
			normalizeLocale: false,
		})}
	/>
))}
<link
	rel="alternate"
	hreflang="x-default"
	href={getAbsoluteLocaleUrl(defaultLocale, pathWithoutLocale, {
	normalizeLocale: false,
})}
>
