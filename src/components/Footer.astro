---
import IconLinkExternals from "./ui/IconLinkExternals.astro";

const t = Astro.locals.t;
---

<footer
	class="d-footer items-center justify-between gap-4.5 border-b r-border-subtle bg-base-100 r-container-padding-horizontal py-9 sm:d-footer-horizontal"
>
	<aside class="grid-flow-col items-center">
		<p>© <span id="year">2026</span> {t("footer.copyright")}</p>
	</aside>
	<nav class="grid-flow-col gap-4 md:place-self-center md:justify-self-end">
		<IconLinkExternals />
	</nav>
</footer>

<script is:inline>
	function updateYear() {
		const yearTextElement = window.document.getElementById("year");
		if (!(yearTextElement instanceof HTMLSpanElement)) return;

		yearTextElement.textContent = String(new Date().getFullYear());
	}

	window.document.addEventListener("astro:page-load", updateYear);
</script>
