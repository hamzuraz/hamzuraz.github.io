---
import { Copyright } from "@lucide/astro";
import ProfileIconButtonLinks from "@/components/common/button-link/ProfileIconButtonLinks.astro";
import { localizeFooter } from "@/i18n/common/localize-footer";
import { getLocale } from "@/i18n/i18n";

const locale = getLocale(Astro.currentLocale);
const t = localizeFooter(locale);
const currentYear = new Date().getFullYear();
---

<footer
	class="px-3 sm:px-6 py-6 bg-background rounded-t-lg flex flex-col sm:flex-row gap-4 items-center justify-between"
>
	<p class="text-xs sm:text-sm text-muted-foreground flex items-center gap-1">
		<Copyright class="size-4" />
		<span data-current-year>{currentYear}</span>
		<span>Rifki Muhazzar. {t.rights}</span>
	</p>
	<ProfileIconButtonLinks />
</footer>
