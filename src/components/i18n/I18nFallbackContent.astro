---
import { OctagonAlert } from "@lucide/astro";
import SectionContainer from "@/components/common/container/SectionContainer.astro";

interface Props {
	languageName: string;
}

const { languageName } = Astro.props;
---

<SectionContainer
	class="flex items-center justify-center h-[calc(100dvh-2px-2px-3.75rem-7.25rem)] sm:h-[calc(100dvh-2px-2px-3.75rem-5.25rem)]"
>
	<div class="-mt-64 flex flex-col items-center gap-4">
		<OctagonAlert class="w-16 h-16 stroke-muted-foreground stroke-1" />
		<h1 class="text-center">
			This page is not available in{" "}
			<span class="font-pixel text-lg">
				{languageName}
			</span>{" "}
			yet, please choose another language.
		</h1>
	</div>
</SectionContainer>
