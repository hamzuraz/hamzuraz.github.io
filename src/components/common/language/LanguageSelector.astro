---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Check, ChevronDown, Languages } from "@lucide/astro";
import Kbd from "@/components/common/kbd/Kbd.astro";
import { localizeLanguageSelector } from "@/i18n/common/localizeLanguageSelector";
import { getLocale, locales } from "@/i18n/i18n";

interface Props {
	pathWithoutLocale?: string;
}

const { pathWithoutLocale } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = localizeLanguageSelector(locale);
const currentLanguage = locales.find(({ code }) => code === locale);
---

<div id="language-selector" class="dropdown-menu">
	<button
		type="button"
		id="language-selector-trigger"
		class="btn group w-60 cursor-pointer"
		aria-controls="language-selector-menu"
		aria-expanded="false"
		aria-haspopup="menu"
		data-shortcut="l"
		data-variant="outline"
	>
		<Languages />
		<span class="truncate w-full text-left">
			<span class="text-sm text-foreground">{currentLanguage?.name}</span>
			{" "}
			<span class="text-xs text-muted-foreground">
				{currentLanguage?.code}
			</span>
		</span>
		<Kbd>L</Kbd>
		<ChevronDown
			class="text-muted-foreground opacity-50 shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180"
		/>
	</button>

	<div
		id="language-selector-popover"
		class="w-full"
		aria-hidden="true"
		data-popover
	>
		<div
			role="menu"
			id="language-selector-menu"
			aria-labelledby="language-selector-trigger"
		>
			<div role="group" aria-labelledby="language-selector-languages">
				<div role="heading" id="language-selector-languages">
					{t.heading}
				</div>
				{locales.map((language) => (
	<a
		href={getRelativeLocaleUrl(language.code, pathWithoutLocale, {
			normalizeLocale: false,
		})}
		role="menuitemradio"
		class="cursor-pointer items-baseline"
		aria-checked={language.code === locale ? "true" : "false"}
	>
		{language.name}
		<span class="text-xs text-muted-foreground pointer-events-none">
			{language.code}
		</span>
		<span data-indicator>
			<Check />
		</span>
	</a>
))}
			</div>
		</div>
	</div>
</div>
