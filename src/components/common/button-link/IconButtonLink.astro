---
interface Props {
	href: string;
	target?: string;
	rel?: string;
	ariaLabel: string;
	tooltip: string;
}

const { href, target, rel, ariaLabel, tooltip } = Astro.props;
---

<a
	href={href}
	target={target}
	rel={rel}
	class="btn cursor-pointer max-lg:[&:hover::before]:hidden"
	aria-label={ariaLabel}
	data-size="icon"
	data-variant="outline"
	data-tooltip={tooltip}
>
	<slot />
</a>
