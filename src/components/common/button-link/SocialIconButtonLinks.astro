---
import { socialLinks } from "@/data/social-links";
import IconButtonLink from "./IconButtonLink.astro";
---

<div class="flex gap-2.5">
	{socialLinks.map((link) => (
	<IconButtonLink
		href={link.href}
		target={link.target}
		rel={link.rel}
		tooltip={link.name}
		ariaLabel={link.ariaLabel}
	>
		<link.icon />
	</IconButtonLink>
))}
</div>
