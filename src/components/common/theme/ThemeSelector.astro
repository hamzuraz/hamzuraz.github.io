---
import { Check, ChevronDown, Wallpaper } from "@lucide/astro";
import Kbd from "@/components/common/kbd/Kbd.astro";
import { themes } from "@/data/themes";
import { localizeTheme } from "@/i18n/common/localizeTheme";
import { getLocale } from "@/i18n/i18n";

const locale = getLocale(Astro.currentLocale);
const localizedTheme = localizeTheme(locale);
---

<div id="theme-selector" class="dropdown-menu">
	<button
		type="button"
		id="theme-selector-trigger"
		class="btn group w-60 cursor-pointer"
		data-shortcut="t"
		data-variant="outline"
		aria-controls="theme-selector-menu"
		aria-expanded="false"
		aria-haspopup="menu"
	>
		<Wallpaper />
		<span class="truncate w-full text-left">
			<span class="text-sm text-foreground" data-theme-name></span>{" "}
			<span class="text-xs text-muted-foreground" data-theme-mode></span>
		</span>
		<Kbd>T</Kbd>
		<ChevronDown
			class="text-muted-foreground opacity-50 shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180"
		/>
	</button>

	<div
		id="theme-selector-popover"
		class="w-full"
		data-popover
		aria-hidden="true"
	>
		<div
			role="menu"
			id="theme-selector-menu"
			aria-labelledby="theme-selector-trigger"
		>
			<div role="group" aria-labelledby="theme-selector-themes">
				<div role="heading" id="theme-selector-themes">
					{localizedTheme.heading}
				</div>
				{themes.map((theme) => (
	<div
		role="menuitemradio"
		class="cursor-pointer"
		data-value={theme.id}
		data-theme-name={theme.name}
		data-theme-mode={
			theme.mode === "Light"
				? localizedTheme.modes.light
				: localizedTheme.modes.dark
		}
		aria-checked="false"
	>
		<span>{theme.name}</span>
		<span class="text-xs text-muted-foreground">
			{theme.mode === "Light"
				? localizedTheme.modes.light
				: localizedTheme.modes.dark}
		</span>
		<span data-indicator>
			<Check />
		</span>
	</div>
))}
			</div>
		</div>
	</div>
</div>
