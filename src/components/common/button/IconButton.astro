---
interface Props {
	ariaLabel: string;
	tooltip: string;
	copyValue?: string;
}

const { ariaLabel, tooltip, copyValue } = Astro.props;
---

<button
	type="button"
	class="btn cursor-pointer max-lg:[&:hover::before]:hidden"
	aria-label={ariaLabel}
	data-size="icon"
	data-variant="outline"
	data-tooltip={tooltip}
	data-copy-value={copyValue}
>
	<slot />
</button>
