---
import GitHub from "$/assets/GitHub.svg";
import LinkedIn from "$/assets/LinkedIn.svg";
import ExternalLink from "./ExternalLink.astro";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
const iconClass =
	"size-7 sm:size-9 hover:stroke-neutral-600 dark:hover:stroke-neutral-400 transition-colors";
---

<div class:list={["flex gap-1.5 sm:gap-2.5", className]}>
	<ExternalLink href="https://github.com/hamzuraz/" ariaLabel="GitHub">
		<GitHub class={iconClass} />
	</ExternalLink>
	<ExternalLink href="#" ariaLabel="LinkedIn">
		<LinkedIn class={iconClass} />
	</ExternalLink>
</div>
