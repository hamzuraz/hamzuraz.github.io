---
import { ArrowRight, SquareArrowOutUpRight } from "@lucide/astro";
import { defaultIconProps } from "$/lib/icon-props";

const t = Astro.locals.t;

const projects = [1, 2, 3, 4];
---

<section id="projects" class="border-b u-border-color u-layout-padding">
    <h2 class="u-text-5xl font-bold">
        {t("home.projects.title")}
    </h2>

    <p class="u-text-lg mt-6">{t("home.projects.description")}</p>

    <div
        class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-box border u-border-color bg-subtle-border-light sm:grid-cols-2 dark:bg-subtle-border-dark"
    >
        {
            projects.map((project, index) => {
                const radiusClass =
                    index === 0
                        ? "rounded-t-box rounded-b-none sm:rounded-tl-box sm:rounded-tr-none"
                        : index === 1
                          ? "rounded-none sm:rounded-tr-box"
                          : index === 2
                            ? "rounded-none sm:rounded-bl-box"
                            : "rounded-t-none rounded-b-box sm:rounded-br-box sm:rounded-bl-none";
                return (
                    <div class={`d-card ${radiusClass} bg-base-100 shadow-sm`}>
                        <div class="d-card-body p-4 gap-0">
                            <h2 class="d-card-title">Social Media</h2>
                            <ul class="flex gap-2 mt-2">
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Svelte Kit
                                    </div>
                                </li>
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Go
                                    </div>
                                </li>
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Rust
                                    </div>
                                </li>
                            </ul>

                            <p class="mt-4">
                                A card component has a figure, a body part, and
                                inside body there are title and actions parts
                            </p>
                            <div class="d-card-actions justify-end mt-16 gap-3">
                                <button class="d-btn d-btn-primary d-btn-outline">
                                    Source Code
                                    <SquareArrowOutUpRight
                                        {...defaultIconProps}
                                    />
                                </button>
                                <button class="d-btn d-btn-primary">
                                    See Details
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </div>
    <a
        href="projects/"
        class="d-btn mt-12 flex w-full items-center justify-center gap-2 d-btn-outline d-btn-primary sm:mx-auto sm:w-fit lg:mt-16"
    >
        See All Projects
        <ArrowRight {...defaultIconProps} aria-hidden="true" />
    </a>
</section>
