---
import { ArrowRight, SquareArrowOutUpRight } from "@lucide/astro";
import { iconProps } from "$/utils/icon-props";

const t = Astro.locals.t;

const projects = [1, 2, 3, 4];
---

<section id="projects" class="border-b r-border-subtle r-container-padding">
	<p
		class="font-mono text-xs font-semibold tracking-[0.2em] r-text-subtle uppercase"
	>
		{t("home.projects.eyebrow")}
	</p>
	<h2 class="mt-3 r-text-larger font-bold">
		{t("home.projects.title")}
	</h2>
	<p class="mt-6 max-w-xl r-text-medium">{t("home.projects.description")}</p>
	<div
		class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-box border r-border-subtle bg-subtle-light-border sm:grid-cols-2 dark:bg-subtle-dark-border"
	>
		{projects.map((_, index) => {
                const radiusClass =
                    index === 0
                        ? "rounded-t-box rounded-b-none sm:rounded-tl-box sm:rounded-tr-none"
                        : index === 1
                          ? "rounded-none sm:rounded-tr-box"
                          : index === 2
                            ? "rounded-none sm:rounded-bl-box"
                            : "rounded-t-none rounded-b-box sm:rounded-br-box sm:rounded-bl-none";
                return (
                    <div class={`${radiusClass} d-card bg-base-100 shadow-sm`}>
                        <div class="d-card-body p-6 gap-0">
                            <h2 class="d-card-title">Social Media</h2>
                            <ul class="flex gap-2 mt-2">
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Svelte Kit
                                    </div>
                                </li>
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Go
                                    </div>
                                </li>
                                <li>
                                    <div class="d-badge d-badge-soft d-badge-accent d-badge-sm">
                                        Rust
                                    </div>
                                </li>
                            </ul>
                            <p class="mt-4">
                                A card component has a figure, a body part, and
                                inside body there are title and actions parts
                            </p>
                            <div class="d-card-actions justify-end mt-16 gap-3">
                                <button
                                    type="button"
                                    class="d-btn d-btn-primary d-btn-outline"
                                >
                                    Source Code
                                    <SquareArrowOutUpRight
                                        {...iconProps}
                                    />
                                </button>
                                <button
                                    type="button"
                                    class="d-btn d-btn-primary"
                                >
                                    See Details
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })}
	</div>
	<a
		href="projects/"
		class="d-btn mt-12 flex w-full items-center justify-center gap-2 d-btn-outline d-btn-primary sm:mx-auto sm:w-fit lg:mt-16"
	>
		See All Projects
		<ArrowRight {...iconProps} aria-hidden="true" />
	</a>
</section>
