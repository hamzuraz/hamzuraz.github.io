---
const { langCode, t } = Astro.locals;
const lastUpdated = new Date().toLocaleDateString(langCode, {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<section
    id="_hero"
    class="border-b border-line-on-light px-4 pt-8 pb-32 sm:px-8 dark:border-line-on-dark"
>
    <div class="font-mono text-xs sm:text-sm">
        <span class="font-bold text-secondary">———</span>
        <span>&nbsp;&nbsp;{t("home.hero.lastupdated")}&nbsp;{lastUpdated}</span>
    </div>

    <div
        class="mt-16 d-badge d-badge-soft font-mono d-badge-sm tracking-widest uppercase d-badge-secondary sm:d-badge-md"
    >
        {t("home.hero.badge.role")}
    </div>

    <h1 class="mt-1 text-4.5xl font-bold text-primary sm:text-7xl">
        Rifki Muhazzar
    </h1>

    <p class="mt-6 max-w-xl text-lg sm:text-xl">
        {t("home.hero.subheading")}
    </p>

    <ul class="mt-6 flex flex-wrap gap-2 font-mono sm:gap-3">
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-error sm:d-badge-md"
            >
                HTML
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                CSS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-warning sm:d-badge-md"
            >
                JS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                TS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                Python
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                Go
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-error sm:d-badge-md"
            >
                Rust
            </div>
        </li>
        <li>
            <a class="d-link text-sm d-link-accent sm:text-base">
                {t("home.hero.techstack.more")}</a
            >
        </li>
    </ul>

    <div class="mt-12 flex items-baseline gap-4 sm:gap-6">
        <div class="d-aura d-aura-silver d-aura-md sm:d-aura-lg duration-7000">
            <div class="d-card bg-base-100">
                <button class="d-btn d-btn-md d-btn-primary sm:d-btn-lg">
                    {t("home.hero.cta.primary")}
                </button>
            </div>
        </div>
        <button
            class="d-btn d-btn-outline d-btn-md d-btn-secondary sm:d-btn-lg"
        >
            {t("home.hero.cta.secondary")}
        </button>
    </div>
</section>
