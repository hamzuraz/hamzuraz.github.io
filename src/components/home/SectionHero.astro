---
const { langCode, t } = Astro.locals;
const lastUpdated = new Date().toLocaleDateString(langCode, {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<section
    id="_hero"
    class="border-b border-line-on-light px-4 pt-12 pb-24 sm:px-8 sm:pt-16 sm:pb-32 lg:pt-20 lg:pb-40 dark:border-line-on-dark"
>
    <p
        class="font-mono text-xs text-subtle-on-light sm:text-sm dark:text-subtle-on-dark"
    >
        {t("home.hero.lastupdated")}&nbsp;{lastUpdated}
    </p>

    <div
        class="mt-10 d-badge d-badge-soft font-mono d-badge-sm tracking-widest uppercase d-badge-accent sm:mt-12 sm:d-badge-md"
    >
        {t("home.hero.badge.role")}
    </div>

    <h1
        class="mt-2 text-4.5xl font-bold tracking-tight text-primary sm:text-6xl lg:text-7xl"
    >
        Rifki Muhazzar
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
        {t("home.hero.subheading")}
    </p>

    <ul
        class="mt-8 flex flex-wrap gap-2 font-mono sm:mt-10 sm:gap-3 items-baseline"
    >
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-error sm:d-badge-md"
            >
                HTML
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                CSS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-warning sm:d-badge-md"
            >
                JS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                TS
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                Python
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-info sm:d-badge-md"
            >
                Go
            </div>
        </li>
        <li>
            <div
                class="d-badge d-badge-soft d-badge-sm d-badge-error sm:d-badge-md"
            >
                Rust
            </div>
        </li>
        <li class="d-link text-sm d-link-accent sm:text-base">
            {t("home.hero.techstack.more")}
        </li>
    </ul>

    <div class="mt-10 flex flex-wrap items-baseline gap-4 sm:mt-14 sm:gap-6">
        <div class="d-aura d-aura-silver duration-7000 d-aura-md sm:d-aura-lg">
            <div class="d-card bg-base-100">
                <button class="d-btn d-btn-md d-btn-primary sm:d-btn-lg">
                    {t("home.hero.cta.primary")}
                </button>
            </div>
        </div>
        <button class="d-btn d-btn-outline d-btn-accent d-btn-md sm:d-btn-lg">
            {t("home.hero.cta.secondary")}
        </button>
    </div>
</section>
