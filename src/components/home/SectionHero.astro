---
const { langCode, t } = Astro.locals;
const lastUpdated = new Date().toLocaleDateString(langCode, {
	year: "numeric",
	month: "long",
	day: "numeric",
});
const techStack = [
	{ name: "JavaScript", badgeColor: "warning" },
	{ name: "TypeScript", badgeColor: "info" },
	{ name: "Python", badgeColor: "info" },
	{ name: "Go", badgeColor: "info" },
	{ name: "Rust", badgeColor: "error" },
];
---

<section id="_hero" class="border-b u-border-color u-layout-padding">
    <p class="font-mono text-xs u-text-subtle sm:text-sm">
        {t("home.hero.lastupdated")}&nbsp;{lastUpdated}
    </p>

    <div
        class="mt-10 d-badge d-badge-soft font-mono d-badge-sm tracking-widest uppercase d-badge-accent sm:mt-12 sm:d-badge-md"
    >
        {t("home.hero.badge.role")}
    </div>

    <h1
        class="mt-2 text-4.5xl font-bold tracking-tight text-primary sm:text-7xl"
    >
        Rifki Muhazzar
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
        {t("home.hero.subheading")}
    </p>

    <ul
        class="mt-8 flex flex-wrap items-baseline gap-2 font-mono sm:mt-10 sm:gap-3"
    >
        {
            techStack.map((tech) => (
                <li>
                    <div
                        class={`d-badge-${tech.badgeColor} d-badge d-badge-soft d-badge-sm sm:d-badge-md`}
                    >
                        {tech.name}
                    </div>
                </li>
            ))
        }
        <li class="ml-0.5 d-link text-sm d-link-accent sm:text-base">
            {t("home.hero.techstack.more")}
        </li>
    </ul>

    <div class="mt-10 flex items-baseline gap-4 sm:mt-14 sm:gap-6">
        <button class="d-btn d-btn-primary sm:d-btn-lg">
            {t("home.hero.cta.primary")}
        </button>
        <button class="d-btn d-btn-outline d-btn-accent sm:d-btn-lg">
            {t("home.hero.cta.secondary")}
        </button>
    </div>
</section>
