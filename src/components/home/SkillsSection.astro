---
import { BookOpenCheck, Layers, Star } from "@lucide/astro";
import Badge from "@/components/common/badge/Badge.astro";
import SectionContainer from "@/components/common/container/SectionContainer.astro";
import { skillCategories } from "@/data/skills";
import type { HomePageTranslation } from "@/i18n/pages/home/homePage";

interface Props {
	t: HomePageTranslation | undefined;
}

const { t } = Astro.props;

const coreCategories = skillCategories.filter(
	(category) => category.core.length > 0,
);
const familiarCategories = skillCategories.filter(
	(category) => category.familiar.length > 0,
);
const allCategories = skillCategories.filter(
	(category) => category.core.length > 0 || category.familiar.length > 0,
);
---

<SectionContainer id="skills">
	<div>
		<span
			class="font-pixel text-xs text-muted-foreground tracking-widest uppercase"
		>
			{t?.skills.sectionTag}
		</span>
		<h2 class="font-pixel text-2xl sm:text-3xl mt-2">
			{t?.skills.heading}
		</h2>
		<p class="text-sm sm:text-base text-muted-foreground mt-1.25 max-w-2xl">
			{t?.skills.description}
		</p>
	</div>

	<div class="mt-8 border rounded-xl overflow-hidden">
		<div class="tabs border-b py-2 px-3" id="tabs-skills">
			<nav
				role="tablist"
				class="gap-6 bg-background"
				aria-orientation="horizontal"
				data-variant="line"
			>
				<button
					type="button"
					role="tab"
					id="tabs-skills-tab-all"
					class="cursor-pointer after:-bottom-0.75 px-0"
					aria-controls="tabs-skills-panel-all"
					aria-selected="true"
					tabindex="0"
				>
					<Layers aria-hidden="true" />
					{t?.skills.tabs.all}
				</button>
				<button
					type="button"
					role="tab"
					id="tabs-skills-tab-core"
					class="cursor-pointer after:-bottom-0.75 px-0"
					aria-controls="tabs-skills-panel-core"
					aria-selected="false"
					tabindex="-1"
				>
					<Star aria-hidden="true" />
					{t?.skills.tabs.core}
				</button>
				<button
					type="button"
					role="tab"
					id="tabs-skills-tab-familiar"
					class="cursor-pointer after:-bottom-0.75 px-0"
					aria-controls="tabs-skills-panel-familiar"
					aria-selected="false"
					tabindex="-1"
				>
					<BookOpenCheck aria-hidden="true" />
					{t?.skills.tabs.familiar}
				</button>
			</nav>
		</div>

		<div
			role="tabpanel"
			id="tabs-skills-panel-all"
			aria-labelledby="tabs-skills-tab-all"
			tabindex="-1"
			class="divide-y"
		>
			{allCategories.map((category) => (
	<div class="p-4 grid grid-cols-1 md:grid-cols-12 gap-3 items-baseline">
		<div class="md:col-span-4 font-medium text-sm text-foreground">
			{t?.skills.categories[category.id]}
		</div>
		<div class="md:col-span-8 flex flex-wrap gap-2">
			{category.core.map((skill) => (
				<Badge>{skill}</Badge>
			))}
			{category.familiar.map((skill) => (
				<Badge variant="outline">{skill}</Badge>
			))}
		</div>
	</div>
))}
		</div>

		<div
			role="tabpanel"
			id="tabs-skills-panel-core"
			aria-labelledby="tabs-skills-tab-core"
			tabindex="-1"
			class="divide-y"
			hidden
		>
			{coreCategories.map((category) => (
	<div class="p-4 grid grid-cols-1 md:grid-cols-12 gap-3 items-baseline">
		<div class="md:col-span-4 font-medium text-sm text-foreground">
			{t?.skills.categories[category.id]}
		</div>
		<div class="md:col-span-8 flex flex-wrap gap-2">
			{category.core.map((skill) => (
				<Badge>{skill}</Badge>
			))}
		</div>
	</div>
))}
		</div>

		<div
			role="tabpanel"
			id="tabs-skills-panel-familiar"
			aria-labelledby="tabs-skills-tab-familiar"
			tabindex="-1"
			class="divide-y"
			hidden
		>
			{familiarCategories.map((category) => (
	<div class="p-4 grid grid-cols-1 md:grid-cols-12 gap-3 items-baseline">
		<div class="md:col-span-4 font-medium text-sm text-foreground">
			{t?.skills.categories[category.id]}
		</div>
		<div class="md:col-span-8 flex flex-wrap gap-2">
			{category.familiar.map((skill) => (
				<Badge variant="outline">{skill}</Badge>
			))}
		</div>
	</div>
))}
		</div>
	</div>
</SectionContainer>
