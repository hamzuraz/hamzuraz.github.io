---
import Section from "$/components/ui/Section.astro";
import SectionHeader from "$/components/ui/SectionHeader.astro";
import { skillTabs } from "$/data/skills";

const t = Astro.locals.t;
---

<Section id="skills">
	<SectionHeader
		eyebrow={t("home.skills.eyebrow")}
		title={t("home.skills.title")}
		description={t("home.skills.description")}
	/>
	<div
		role="tablist"
		class="d-tabs mt-6 w-full overflow-hidden rounded-box border border-neutral-400 dark:border-neutral-700"
	>
		{skillTabs.map((tab, index) => (
			<>
				<input
					type="radio"
					name="skills_tabs"
					class="d-tab text-xs text-base-content/75 sm:text-sm transition-colors checked:bg-base-content/10 checked:text-base-content hover:bg-base-content/10 hover:text-base-content"
					aria-label={t(tab.labelKey)}
					checked={index === 0}
				/>
				<div class="d-tab-content min-w-0 rounded-t-none border-x-0 border-t border-b-0 border-neutral-400 dark:border-neutral-700 bg-base-100 p-6">
					{tab.skills.map((skill) => (
						<section class="grid grid-cols-1 gap-3 border-t border-neutral-400 dark:border-neutral-700 py-4 first:border-t-0 first:pt-0 last:pb-0 sm:grid-cols-[minmax(8rem,0.35fr)_minmax(0,1fr)] sm:gap-6">
							<h3 class="text-sm font-semibold tracking-widest text-base-content">
								{t(skill.scopeKey)}
							</h3>
							<ul class="flex flex-wrap gap-2 font-mono">
								{skill.technologies.map((technology) => (
									<li>
										<span
											class:list={[
												"d-badge d-badge-soft d-badge-sm",
												skill.isCore &&
													"d-badge-accent",
											]}
										>
											{technology}
										</span>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			</>
		))}
	</div>
</Section>
