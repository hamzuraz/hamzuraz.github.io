---
const t = Astro.locals.t;

type SkillRow = {
	scope: string;
	technologies: string[];
	badgeClass: "d-badge-secondary" | "d-badge-accent" | "";
	scopeClass: "text-base-content";
};

const coreSkills: SkillRow[] = [
	{
		scope: "Language & Runtime",
		technologies: ["JavaScript", "TypeScript", "Node.js", "Bun", "Go"],
		badgeClass: "d-badge-secondary",
		scopeClass: "text-base-content",
	},
	{
		scope: "WEB",
		technologies: [
			"HTML",
			"CSS",
			"Tailwind CSS",
			"React",
			"Next.js",
			"Svelte",
			"SvelteKit",
			"Astro",
		],
		badgeClass: "d-badge-secondary",
		scopeClass: "text-base-content",
	},
	{
		scope: "Mobile",
		technologies: ["React Native", "Expo"],
		badgeClass: "d-badge-secondary",
		scopeClass: "text-base-content",
	},
	{
		scope: "Databases",
		technologies: ["MySQL", "PostgreSQL", "SQLite", "MongoDB"],
		badgeClass: "d-badge-secondary",
		scopeClass: "text-base-content",
	},
	{
		scope: "Tooling & Workflow",
		technologies: [
			"Git",
			"GitHub",
			"Docker",
			"Vite",
			"Vitest",
			"Biome",
			"Lefthook",
		],
		badgeClass: "d-badge-secondary",
		scopeClass: "text-base-content",
	},
];

const familiarSkills: SkillRow[] = [
	{
		scope: "Familiar",
		technologies: ["Python", "Rust", "Alpine.js", "HTMX"],
		badgeClass: "d-badge-accent",
		scopeClass: "text-base-content",
	},
];

const beyondCodeSkills: SkillRow[] = [
	{
		scope: "Design",
		technologies: ["Canva", "Figma"],
		badgeClass: "",
		scopeClass: "text-base-content",
	},
	{
		scope: "Languages",
		technologies: ["English", "Bahasa Indonesia"],
		badgeClass: "",
		scopeClass: "text-base-content",
	},
];

const allSkills = [...coreSkills, ...familiarSkills, ...beyondCodeSkills];
const skillTabs = [
	{ label: "All", skills: allSkills },
	{ label: "Core", skills: coreSkills },
	{ label: "Familiar", skills: familiarSkills },
	{ label: "Other", skills: beyondCodeSkills },
];
---

<section id="skills" class="border-b u-border-color u-layout-padding">
	<p
		class="font-mono text-xs font-semibold uppercase tracking-[0.2em] u-text-subtle"
	>
		02 / Expertise
	</p>

	<h2 class="u-text-5xl mt-3 font-bold">{t("home.skills.title")}</h2>

	<p class="u-text-lg mt-6 max-w-xl">{t("home.skills.description")}</p>

	<div
		class="d-tabs mt-6 w-full rounded-box border u-border-color font-mono overflow-hidden"
	>
		{
			skillTabs.map((tab, index) => (
				<>
					<input
						type="radio"
						name="skills_tabs"
						class="d-tab text-base-content/70 hover:bg-base-content/10 hover:text-base-content checked:bg-base-content/10 checked:text-base-content active:bg-neutral active:text-neutral-content"
						aria-label={tab.label}
						checked={index === 0}
					/>
					<div class="d-tab-content min-w-0 border-t border-x-0 border-b-0 rounded-t-none bg-base-100 p-6 u-border-color">
						<div>
							{tab.skills.map((skill) => (
								<div class="grid grid-cols-1 gap-3 border-t py-4 first:border-t-0 u-border-color first:pt-0 last:pb-0 sm:grid-cols-[minmax(8rem,0.35fr)_minmax(0,1fr)] sm:gap-6">
									<span
										class={`text-sm font-semibold uppercase tracking-widest ${skill.scopeClass}`}
									>
										{skill.scope}
									</span>
									<div class="flex flex-wrap gap-2">
										{skill.technologies.map(
											(technology) => (
												<span
													class={`d-badge d-badge-soft ${skill.badgeClass} d-badge-sm`}
												>
													{technology}
												</span>
											),
										)}
									</div>
								</div>
							))}
						</div>
					</div>
				</>
			))
		}
	</div>
</section>
