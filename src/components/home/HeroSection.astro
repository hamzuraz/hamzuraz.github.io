---
import Section from "$/components/ui/Section.astro";
import SocialLinks from "$/components/ui/SocialLinks.astro";

const { langCode, t } = Astro.locals;

const lastUpdated = new Date().toLocaleDateString(langCode, {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const techStack = ["JavaScript", "TypeScript", "Node.js", "Bun", "Go"];
---

<Section id="_hero">
	<div
		class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center"
	>
		<p
			class="font-mono text-xs text-neutral-400 dark:text-neutral-500 sm:text-sm"
		>
			{t("home.hero.eyebrow")}&nbsp;{lastUpdated}
		</p>
		<SocialLinks />
	</div>
	<div
		class="mt-10 d-badge d-badge-soft font-mono d-badge-sm tracking-widest uppercase d-badge-accent sm:mt-12 sm:d-badge-md"
	>
		{t("home.hero.role")}
	</div>
	<h1
		class="mt-2 text-4.5xl font-bold tracking-tight text-base-content sm:text-7xl"
	>
		Rifki Muhazzar
	</h1>
	<p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
		{t("home.hero.subheading")}
	</p>
	<ul
		class="mt-8 flex flex-wrap items-baseline gap-2 font-mono sm:mt-10 sm:gap-3"
	>
		{techStack.map((tech) => (
			<li>
				<div class="d-badge d-badge-soft d-badge-accent d-badge-sm sm:d-badge-md">
					{tech}
				</div>
			</li>
		))}
		<li>
			<a
				href="#skills"
				class="ml-0.5 d-link text-sm d-link-primary sm:text-base"
			>
				{t("home.hero.seemore")}
			</a>
		</li>
	</ul>
	<div class="mt-10 flex items-baseline gap-4 sm:mt-14 sm:gap-6">
		<a
			href="#contact"
			class="d-btn d-btn-primary sm:d-btn-lg w-30 sm:w-37.5"
		>
			{t("home.hero.cta.primary")}
		</a>
		<a
			href="#projects"
			class="d-btn d-btn-neutral sm:d-btn-lg w-30 sm:w-37.5"
		>
			{t("home.hero.cta.secondary")}
		</a>
	</div>
</Section>
