---
import { Check, Copy, Mail, SquareArrowOutUpRight } from "@lucide/astro";
import LinkedIn from "$/assets/LinkedIn.svg";

export interface Props {
	type: "email" | "linkedin";
	value: string;
	href: string;
	copyLabel: string;
	openLabel: string;
	copiedTip: string;
	isExternal: boolean;
}

const { type, value, href, copyLabel, openLabel, copiedTip, isExternal } =
	Astro.props;
---

<div
	class="flex min-w-0 items-center justify-between gap-3 rounded-box border border-neutral-400 dark:border-neutral-700 bg-base-100 p-3.5 sm:p-4"
>
	<div class="flex min-w-0 flex-1 items-center gap-2.5 sm:gap-3">
		{type === "email" ? (
			<Mail class="size-4.5 shrink-0 text-neutral-400 dark:text-neutral-500" />
		) : (
			<LinkedIn class="size-4.5 shrink-0 text-neutral-400 dark:text-neutral-500" />
		)}
		<span
			class="truncate font-mono text-xs font-medium select-all text-base-content sm:text-sm md:text-base"
			title={value}
		>
			{value}
		</span>
	</div>

	<div class="flex shrink-0 items-center gap-2">
		<div
			class="d-tooltip d-tooltip-top"
			data-tip={copyLabel}
			data-copy-tooltip
		>
			<button
				type="button"
				class="d-btn d-btn-square d-btn-sm d-btn-ghost border border-neutral-400 dark:border-neutral-700 transition-colors hover:bg-base-200"
				data-copy-button
				data-copy-value={value}
				data-copied-tip={copiedTip}
				aria-label={copyLabel}
			>
				<Copy class="copy-icon size-4" />
				<Check class="check-icon size-4 hidden text-success" />
			</button>
		</div>

		<div class="d-tooltip d-tooltip-top" data-tip={openLabel}>
			<a
				href={href}
				target={isExternal ? "_blank" : undefined}
				rel={isExternal ? "noopener noreferrer" : undefined}
				class="d-btn d-btn-square d-btn-sm d-btn-primary"
				aria-label={openLabel}
			>
				<SquareArrowOutUpRight class="size-4" />
			</a>
		</div>
	</div>
</div>
