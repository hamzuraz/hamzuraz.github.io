---
import { SquareArrowOutUpRight } from "@lucide/astro";
import { iconProps } from "$/utils/icon-props";

interface Props {
	title?: string;
	tags?: string[];
	description?: string;
}

const {
	title = "Project Name",
	tags = ["SvelteKit", "Go", "TypeScript"],
	description = "A card component has a figure, a body part, and inside body there are title and actions parts",
} = Astro.props;
---

<article class="d-card rounded-box border border-neutral-400 dark:border-neutral-700 bg-base-100 shadow-sm">
	<div class="d-card-body flex flex-col justify-between p-6 gap-0">
		<div>
			<h3 class="d-card-title text-xl font-bold">{title}</h3>
			<ul class="mt-3 flex flex-wrap gap-2">
				{tags.map((tag) => (
					<li>
						<span class="d-badge d-badge-soft d-badge-accent d-badge-sm font-mono">
							{tag}
						</span>
					</li>
				))}
			</ul>
			<p class="mt-4 text-sm sm:text-base leading-relaxed text-base-content/80 h-20">
				{description}
			</p>
		</div>
		<footer class="d-card-actions justify-end gap-3 pt-6 border-t border-neutral-400/40 dark:border-neutral-700/60 mt-6">
			<button
				type="button"
				class="d-btn d-btn-sm sm:d-btn-md d-btn-neutral sm:w-35"
			>
				Source code
				<SquareArrowOutUpRight {...iconProps} />
			</button>
			<button
				type="button"
				class="d-btn d-btn-sm sm:d-btn-md d-btn-primary sm:w-35"
			>
				Live demo
			</button>
		</footer>
	</div>
</article>
