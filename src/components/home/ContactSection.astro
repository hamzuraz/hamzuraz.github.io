---
import Section from "$/components/common/Section.astro";
import SectionHeader from "$/components/common/SectionHeader.astro";
import ContactCard from "./ContactCard.astro";

const t = Astro.locals.t;

const contactItems = [
	{
		type: "email" as const,
		value: "hamzurazen@gmail.com",
		href: "mailto:hamzurazen@gmail.com",
		copyLabel: t("home.contact.copy.email"),
		openLabel: t("home.contact.cta.email"),
		isExternal: false,
	},
	{
		type: "linkedin" as const,
		value: "https://linkedin.com/",
		href: "https://linkedin.com/",
		copyLabel: t("home.contact.copy.linkedin"),
		openLabel: t("home.contact.cta.linkedin"),
		isExternal: true,
	},
];
---

<Section id="contact" class="w-full max-w-full overflow-x-clip">
	<p
		class="font-mono text-xs font-semibold tracking-[0.2em] text-neutral-400 dark:text-neutral-500 uppercase"
	>
		{t("home.contact.eyebrow")}
	</p>
	<div
		class="mt-3 grid min-w-0 grid-cols-1 items-start gap-8 md:grid-cols-2 md:gap-8 lg:gap-12"
	>
		<SectionHeader
			class="w-full min-w-0"
			title={t("home.contact.title")}
			description={t("home.contact.description")}
		/>

		<div class="flex w-full min-w-0 flex-col gap-4">
			{contactItems.map((item) => (
				<ContactCard
					type={item.type}
					value={item.value}
					href={item.href}
					copyLabel={item.copyLabel}
					openLabel={item.openLabel}
					copiedTip={t("home.contact.copied")}
					isExternal={item.isExternal}
				/>
			))}
		</div>
	</div>

	<div
		id="contact-live-announcer"
		class="sr-only"
		aria-live="polite"
		aria-atomic="true"
	></div>
</Section>

<script src="$/scripts/clipboard.ts"></script>
