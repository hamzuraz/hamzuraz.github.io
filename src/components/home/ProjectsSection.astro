---
import { ArrowRight } from "@lucide/astro";
import Section from "$/components/ui/Section.astro";
import SectionHeader from "$/components/ui/SectionHeader.astro";
import { buildLocalizedRoutePath } from "$/i18n/helpers";
import { iconProps } from "$/utils/icon-props";
import ProjectCard from "./ProjectCard.astro";

const { langCode, t } = Astro.locals;

const projects = [1, 2, 3, 4];
---

<Section id="projects">
	<SectionHeader
		eyebrow={t("home.projects.eyebrow")}
		title={t("home.projects.title")}
		description={t("home.projects.description")}
	/>
	<div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
		{projects.map(() => (
			<ProjectCard />
		))}
	</div>
	<a
		href={buildLocalizedRoutePath(langCode, "/projects/")}
		class="d-btn mt-12 flex w-full items-center justify-center gap-2 d-btn-neutral sm:mx-auto sm:w-fit sm:mt-14"
	>
		{t("home.projects.cta")}
		<ArrowRight
			{...iconProps}
			class="text-neutral-400 dark:text-neutral-500"
			aria-hidden="true"
		/>
	</a>
</Section>
