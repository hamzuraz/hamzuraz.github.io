---
import DefaultButton from "@/components/common/DefaultButton.astro";
import LanguageSelector from "@/components/header/language/LanguageSelector.astro";
---

<section class="empty max-w-lg mx-auto text-center py-16">
	<header>
		<h1
			class="font-pixel text-3xl sm:text-4xl font-bold tracking-tight text-foreground"
		>
			404 - Not Found
		</h1>
		<p class="font-sans text-sm sm:text-base text-muted-foreground mt-2">
			The page you are looking for does not exist or has been moved.
		</p>
	</header>
	<footer
		class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3"
	>
		<DefaultButton href="/"> Go back to homepage (English) </DefaultButton>
		<LanguageSelector />
	</footer>
</section>
