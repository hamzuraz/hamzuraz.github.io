---
import Email from "$/assets/Email.svg";
import GitHub from "$/assets/GitHub.svg";
import LinkedIn from "$/assets/LinkedIn.svg";

const iconClass =
	"size-6 sm:size-8 hover:stroke-neutral-600 dark:hover:stroke-neutral-400 transition-colors stroke-base-content";
---

<ul class="flex gap-1.5 sm:gap-2.5">
	<li>
		<a href="mailto:hamzurazen@gmail.com" aria-label="Email">
			<Email class={iconClass} />
		</a>
	</li>
	<li>
		<a
			href="https://linkedin.com/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="LinkedIn"
		>
			<LinkedIn class={iconClass} />
		</a>
	</li>
	<li>
		<a
			href="https://github.com/hamzuraz/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
		>
			<GitHub class={iconClass} />
		</a>
	</li>
</ul>
