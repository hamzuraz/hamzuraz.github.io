---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/common/card/ProjectCard.astro";
import SectionContainer from "@/components/common/container/SectionContainer.astro";
import type { Locale } from "@/i18n/i18n";
import type { ProjectsPageTranslation } from "@/i18n/pages/projects/projectsPage";

interface Props {
	locale: Locale;
	t: ProjectsPageTranslation | undefined;
}

const { locale, t } = Astro.props;

const allProjects = (
	await getCollection("projects", ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<SectionContainer>
	<div>
		<span
			class="font-pixel text-xs text-muted-foreground tracking-widest uppercase"
		>
			{t?.sectionTag}
		</span>
		<h1 class="font-pixel text-3xl sm:text-4xl mt-2">
			{t?.heading}
		</h1>
		<p class="text-sm sm:text-base text-muted-foreground mt-1.25 max-w-2xl">
			{t?.description}
		</p>
	</div>
	<div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{allProjects.map((project) => (
	<ProjectCard
		title={project.data.title}
		techStack={project.data.techStack}
		description={project.data.description}
		coverImageUrl={project.data.coverImageUrl}
		sourceCodeUrl={project.data.sourceCodeUrl}
		sourceCodeText={project.data.sourceCodeText}
		liveDemoUrl={project.data.liveDemoUrl}
		liveDemoText={project.data.liveDemoText}
	/>
))}
	</div>
</SectionContainer>
